    "merch_tiers": {
      "type": "section",
      "blocks": {
        "checklist": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "{%- liquid\n  assign specs = 'Tee|0|Entry|gildan-5000-heavy-cotton-100-cotton-t-shirt|Gildan 5000|Black|M;Tee|1|Mid|bella-canvas-3001-unisex-jersey-short-sleeve-tee|BELLA+CANVAS 3001|Black|M;Tee|2|Retail-feel|comfort-colors-6030-heavyweight-ring-spun-pocket-tee|Comfort Colors 6030 pocket|Black|M;Layer|0|Entry|gildan-18000-heavy-blend-crewneck-sweatshirt|Gildan 18000 crew|Black|M;Layer|1|Mid|gildan-18500-heavy-blend-hooded-sweatshirt|Gildan 18500 hoodie|Black|M;Layer|2|Retail-feel|comfort-colors-1566-ring-spun-crewneck-sweatshirt|Comfort Colors 1566 crew (Pepper)|Pepper|M;Cap|0|Entry|port-authority-402-snapback-trucker-cap|Port Authority 402|Black|OSFA;Cap|1|Mid|yp-classics-6606-retro-trucker-cap|YP Classics 6606|Black|ADJUSTABLE;Cap|2|Retail-feel|richardson-112-trucker-cap|Richardson 112|Black|OSFA;Tote|0|Entry|liberty-bags-8502-branson-tote|Liberty Bags 8502|Black|OSFA;Tote|1|Mid|q-tees-q800-promotional-tote|Q-Tees Q800|Black|OSFA;Tote|2|Retail-feel|q-tees-q800-promotional-tote|Q-Tees Q800|Black|OSFA' | split: ';'\n  assign t0 = 0\n  assign t1 = 0\n  assign t2 = 0\n  assign t_from = false\n  assign garment_prev = ''\n-%}\n<div class=\"at-checklist\"><div class=\"at-checklist__intro\"><p class=\"at-checklist__eyebrow\">03 / Blank-cost tiers</p><h2 id=\"merch-blank-cost\" class=\"at-checklist__title\">Price a tee, layer, cap and tote at three tiers</h2></div><ol class=\"at-checklist__items\">\n{%- for spec in specs -%}\n  {%- liquid\n    assign f = spec | split: '|'\n    assign garment = f[0]\n    assign tier_index = f[1] | plus: 0\n    assign p = all_products[f[3]]\n    assign price = p.price_min\n    assign found = false\n    for v in p.variants\n      if v.option1 == f[5] and v.option2 == f[6]\n        assign price = v.price\n        assign found = true\n        break\n      endif\n    endfor\n    unless found\n      assign t_from = true\n    endunless\n    case tier_index\n      when 0\n        assign t0 = t0 | plus: price\n      when 1\n        assign t1 = t1 | plus: price\n      else\n        assign t2 = t2 | plus: price\n    endcase\n  -%}\n  {%- if garment != garment_prev -%}\n    {%- unless forloop.first -%}</p></li>{%- endunless -%}\n    <li><strong>{{ garment }}</strong><p>\n    {%- assign garment_prev = garment -%}\n  {%- else -%}<br>{%- endif -%}\n  {{ f[2] }}: <a href=\"/products/{{ f[3] }}\">{{ f[4] }}</a> {% unless found %}from {% endunless %}{{ price | money }}\n  {%- if forloop.last -%}</p></li>{%- endif -%}\n{%- endfor -%}\n</ol>\n<p class=\"at-checklist__note\"><strong>Blank set, one of each:</strong> Entry {% if t_from %}from {% endif %}{{ t0 | money }} &nbsp;&middot;&nbsp; Mid {% if t_from %}from {% endif %}{{ t1 | money }} &nbsp;&middot;&nbsp; Retail-feel {% if t_from %}from {% endif %}{{ t2 | money }}. Current prices for Black in size M or one size (the 1566 crew in Pepper). This is blank cost only, not profit: decoration, freight, tax and packaging are not included.</p>\n<p class=\"at-checklist__note\"><strong>Reorder stock.</strong> Choose the colors and sizes you plan to restock, and check they are still offered in the same style before each reorder.</p>\n<p class=\"at-checklist__note\"><strong>Opening cash.</strong> Add the blanks for the first run to decoration, freight and packaging to see what you need to spend before the first sale.</p>\n<p class=\"at-checklist__note\"><strong>Retail price.</strong> Set it separately, from your full unit cost and what your customers expect to pay. The blank cost above is only one part of it.</p>\n</div>"
          },
          "blocks": {}
        }
      },
