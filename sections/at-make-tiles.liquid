{%- comment -%}
  "What are you making?" photo cards for guests (homepage strategy, design §15). Each card
  opens its project collection. Guest personalization is client-side only (Liquid can't read
  local storage):
  - picking a card saves the answer in localStorage `at_guest_hint` ({q1, url, title, at});
  - on the next visit the cards show "Pick up where you left off" and mark that card;
  - when the Shopify Forms popup opens, the matching Q1 radio is preselected (best effort:
    the Forms markup isn't ours, so this looks for an input whose value is the `use:*` value).
  The `use:*` values and collection URLs are fixed; the photos are per-card settings. Cards
  work without photos (label only). Six in one row on desktop, two columns on mobile.
  The server-rendered page is the same for every guest, so it stands on its own for search.
{%- endcomment -%}
{%- capture at_section_visible -%}{% render 'at-section-visible', visibility: section.settings.at_visibility %}{%- endcapture -%}
{%- if at_section_visible contains 'true' -%}
  {%- liquid
    assign decorator_url = section.settings.decorator_url | default: '/collections/all'
    # q1 value | label | collection URL | image setting id
    assign tiles = "use:decorator|Clients' designs|" | append: decorator_url | append: '|image_decorator'
    assign tiles = tiles | append: ';use:graphic-tees|My own designs|/collections/graphic-tees-boutique-sellers|image_graphic_tees'
    assign tiles = tiles | append: ';use:apparel-brand|My own label|/collections/building-your-apparel-brand|image_apparel_brand'
    assign tiles = tiles | append: ';use:groups-events|Group, team, or event|/collections/groups-events|image_groups_events'
    assign tiles = tiles | append: ';use:business-merch|Company apparel|/collections/business-merch|image_business_merch'
    assign tiles = tiles | append: ';use:personal|Me and my family|/collections/family-matching-sets|image_personal'
    assign tiles = tiles | split: ';'
  -%}
  <div class="section section--page-width">
    <div class="at-tiles" data-at-tiles>
      <div class="at-tiles__head">
        <h2 class="at-tiles__title h3" id="AtTiles-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.helper != blank -%}
          <p class="at-tiles__helper">{{ section.settings.helper }}</p>
        {%- endif -%}
        <p class="at-tiles__resume" data-at-resume hidden>
          Pick up where you left off: <a href="#" data-at-resume-link></a>
        </p>
      </div>
      <ul class="at-tiles__grid" role="list" aria-labelledby="AtTiles-{{ section.id }}">
        {%- for tile in tiles -%}
          {%- liquid
            assign t = tile | split: '|'
            assign tile_image = section.settings[t[3]]
          -%}
          <li>
            <a
              class="at-tiles__tile{% if tile_image != blank %} at-tiles__tile--photo{% endif %}"
              href="{{ t[2] }}"
              data-at-q1="{{ t[0] }}"
              data-at-title="{{ t[1] | escape }}"
            >
              {%- if tile_image != blank -%}
                <span class="at-tiles__media">
                  {{
                    tile_image
                    | image_url: width: 600
                    | image_tag:
                      class: 'at-tiles__image',
                      loading: 'lazy',
                      widths: '240, 360, 480, 600',
                      sizes: '(min-width: 990px) 16vw, (min-width: 750px) 33vw, 50vw',
                      alt: ''
                  }}
                </span>
              {%- endif -%}
              <span class="at-tiles__label">{{ t[1] }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <script>
    (() => {
      const KEY = 'at_guest_hint';
      const root = document.currentScript.previousElementSibling?.querySelector('[data-at-tiles]');
      if (!root) return;
      const read = () => { try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { return null; } };
      const write = (v) => { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch (e) {} };

      root.addEventListener('click', (event) => {
        const tile = event.target.closest('[data-at-q1]');
        if (!tile) return;
        write({ q1: tile.dataset.atQ1, url: tile.getAttribute('href'), title: tile.dataset.atTitle, at: Date.now() });
      });

      const hint = read();
      if (!hint || !hint.q1) return;
      const tile = root.querySelector(`[data-at-q1="${CSS.escape(hint.q1)}"]`);
      if (tile) {
        tile.setAttribute('aria-current', 'true');
        const resume = root.querySelector('[data-at-resume]');
        const link = root.querySelector('[data-at-resume-link]');
        link.textContent = tile.dataset.atTitle || hint.title;
        link.href = hint.url || tile.getAttribute('href');
        resume.hidden = false;
      }

      // Preselect Q1 in the Shopify Forms popup when it appears (best effort, 30 s).
      // One scan now; after that only added nodes are searched. Forms renders in shadow
      // DOM, so shadow roots found in added nodes are watched too. Stops once found.
      const selector = `input[type="radio"][value="${CSS.escape(hint.q1)}"]`;
      const observers = [];
      const watched = new WeakSet();
      let done = false;
      const stop = () => { done = true; observers.splice(0).forEach((o) => o.disconnect()); };
      const search = (node) => {
        if (!node || (node.nodeType !== 1 && node.nodeType !== 11)) return null;
        if (node.matches && node.matches(selector)) return node;
        const hit = node.querySelector(selector);
        if (hit) return hit;
        const hosts = node.shadowRoot ? [node] : [];
        node.querySelectorAll('*').forEach((el) => { if (el.shadowRoot) hosts.push(el); });
        for (const host of hosts) {
          const found = search(host.shadowRoot);
          if (found) return found;
          watch(host.shadowRoot);
        }
        return null;
      };
      const preselect = (input) => {
        stop();
        if (!input.checked && !input.dataset.atTouched) {
          input.dataset.atTouched = '1';
          input.click();
        }
      };
      const onMutations = (records) => {
        if (done) return;
        for (const record of records) {
          for (const node of record.addedNodes) {
            const input = search(node);
            if (input) return preselect(input);
          }
        }
      };
      function watch(root) {
        if (done || watched.has(root)) return;
        watched.add(root);
        const observer = new MutationObserver(onMutations);
        observer.observe(root, { childList: true, subtree: true });
        observers.push(observer);
      }
      const now = search(document.body);
      if (now) return preselect(now);
      watch(document.body);
      setTimeout(stop, 30000);
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .at-tiles {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-block: 28px;
  }
  .at-tiles__head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 18px; }
  .at-tiles__title, .at-tiles__helper, .at-tiles__resume { margin: 0; }
  .at-tiles__helper { font-size: 0.95rem; color: rgb(var(--color-foreground-rgb) / 0.72); }
  .at-tiles__resume { font-size: 0.95rem; flex-basis: 100%; }
  .at-tiles__resume a { font-weight: 700; }
  .at-tiles__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  @media screen and (min-width: 750px) {
    .at-tiles__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
  }
  @media screen and (min-width: 990px) {
    .at-tiles__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }
  .at-tiles__grid > li { min-width: 0; }
  .at-tiles__tile {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    min-height: 64px;
    height: 100%;
    box-sizing: border-box;
    padding: 12px;
    border-radius: 12px;
    border: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
    background: rgb(var(--color-foreground-rgb) / 0.03);
    color: inherit;
    text-decoration: none;
  }
  .at-tiles__tile--photo { justify-content: flex-start; padding: 6px 6px 10px; }
  .at-tiles__media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 8px;
    background: rgb(var(--color-foreground-rgb) / 0.06);
  }
  .at-tiles__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .at-tiles__tile:hover .at-tiles__image { transform: scale(1.03); }
  .at-tiles__tile--photo .at-tiles__label { padding-inline: 6px; }
  .at-tiles__tile:hover, .at-tiles__tile[aria-current='true'] {
    border-color: #2b4a3f;
    background: #e9efec;
    color: #1a2e27;
  }
  .at-tiles__label { font-weight: 700; line-height: 1.25; }
  @media (prefers-reduced-motion: reduce) {
    .at-tiles__image { transition: none; }
    .at-tiles__tile:hover .at-tiles__image { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "What are you making?",
  "tag": "section",
  "class": "at-make-tiles-section",
  "settings": [
    {
      "type": "select",
      "id": "at_visibility",
      "label": "Show to",
      "options": [
        { "value": "all", "label": "Everyone" },
        { "value": "guests", "label": "Guests (signed out)" },
        { "value": "customers", "label": "Signed-in customers" }
      ],
      "default": "guests"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What are you making?"
    },
    {
      "type": "text",
      "id": "helper",
      "label": "Helper text",
      "default": "Choose a project to see blanks that fit."
    },
    {
      "type": "url",
      "id": "decorator_url",
      "label": "Clients' designs link",
      "info": "No single guide for decorators; defaults to all products."
    },
    {
      "type": "header",
      "content": "Card photos",
      "info": "Optional. A card without a photo shows its label only."
    },
    {
      "type": "image_picker",
      "id": "image_decorator",
      "label": "Clients' designs"
    },
    {
      "type": "image_picker",
      "id": "image_graphic_tees",
      "label": "My own designs"
    },
    {
      "type": "image_picker",
      "id": "image_apparel_brand",
      "label": "My own label"
    },
    {
      "type": "image_picker",
      "id": "image_groups_events",
      "label": "Group, team, or event"
    },
    {
      "type": "image_picker",
      "id": "image_business_merch",
      "label": "Company apparel"
    },
    {
      "type": "image_picker",
      "id": "image_personal",
      "label": "Me and my family"
    }
  ],
  "presets": [{ "name": "What are you making?" }]
}
{% endschema %}
