                    <span aria-hidden="true">&rarr;</span>
                  </span>
                </button>
              </div>
            </div>
          </div>
          <button
            type="button"
            class="button button-unstyled close-button at-bulk-grid-modal__close at-msq__close"
            aria-label="{{ 'accessibility.close_dialog' | t }}"
            data-at-msq-close
          >
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
        </dialog>
      </at-msbo-quantities>
    {%- endif -%}
  </div>
</div>

