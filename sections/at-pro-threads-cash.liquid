{%- comment -%}
  Pro PDP section: "How Threads Cash works", a horizontal three-step process on desktop.
  Steps are editor blocks with [tokens]. Earning timing (posting delay), expiry, redemption
  limits and eligible merchandise are not final: keep "Terms are final" off until they are. While
  off, the theme editor shows what is still open and shoppers see only the optional shopper note
  (blank by default), never an unfinished-policy notice. Step copy must stay true without those
  terms: say "once it posts", never "on your next order".
{%- endcomment -%}
{%- capture tier -%}{% render 'at-member-tier' %}{%- endcapture -%}
{%- assign tier = tier | strip -%}
{%- unless tier == 'wholesale' -%}
{{ 'at-pro.css' | asset_url | stylesheet_tag }}
<div class="section section--page-width at-pro-page at-pro-section at-pro-cash">
  <div class="at-pro-section__head">
    <h2 class="at-pro-serif at-pro-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.intro != blank -%}<div class="at-pro-section__intro">{% render 'at-pro-tokens', text: section.settings.intro %}</div>{%- endif -%}
  </div>
  <ol class="at-pro-steps" role="list">
    {%- for block in section.blocks -%}
      <li class="at-pro-steps__item" {{ block.shopify_attributes }}>
        <span class="at-pro-steps__number at-pro-figure" aria-hidden="true">{{ forloop.index }}</span>
        <h3 class="at-pro-steps__title">{% render 'at-pro-tokens', text: block.settings.title %}</h3>
        <div class="at-pro-steps__body">{% render 'at-pro-tokens', text: block.settings.body %}</div>
      </li>
    {%- endfor -%}
  </ol>
  {%- unless section.settings.terms_final -%}
    {%- if section.settings.pending_note != blank -%}
      <p class="at-pro-section__footnote">{{ section.settings.pending_note | escape }}</p>
    {%- endif -%}
    {%- if request.design_mode -%}
      <p class="at-pro-draft at-pro-editor-note">{{ 'at_pro.cash.pending_editor' | t }}</p>
    {%- endif -%}
  {%- endunless -%}
</div>
{%- endunless -%}

{% schema %}
{
  "name": "Pro: Threads Cash",
  "tag": "section",
  "class": "at-pro-section-wrap",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How Threads Cash works" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Pro members earn [cash_rate] back on eligible net merchandise purchases.</p>" },
    { "type": "checkbox", "id": "terms_final", "label": "Terms are final", "default": false, "info": "Leave off until earning timing, expiry, redemption and eligible merchandise are confirmed." },
    { "type": "text", "id": "pending_note", "label": "Shopper note while terms are pending", "info": "Optional. Leave blank so shoppers don’t see unfinished-policy notices; the theme editor always shows what is still open." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Describe this step.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pro: Threads Cash",
      "blocks": [
        { "type": "step", "settings": { "title": "Shop as usual", "body": "<p>Buy your blanks at Pro prices, the same way you order today.</p>" } },
        { "type": "step", "settings": { "title": "Earn [cash_rate] back", "body": "<p>Threads Cash is calculated on what you pay for eligible merchandise, after discounts, returns and cancellations.</p>" } },
        { "type": "step", "settings": { "title": "Use it toward a future order", "body": "<p>Once it posts to your account, apply it as store credit at checkout.</p>" } }
      ]
    }
  ]
}
{% endschema %}
