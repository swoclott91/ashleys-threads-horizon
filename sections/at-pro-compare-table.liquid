{%- comment -%}
  Pro PDP section: Member vs. Pro. Rows are editor blocks; values accept [tokens].
  Rows marked "Pro difference" (pricing, Threads Cash, monthly shipping) carry the emphasis; shared
  benefits are quieter. A Pro Promise row is added automatically while the Promise is visible.
  Guest and Wholesale are deliberately left out so they don't distract from the upgrade decision.
{%- endcomment -%}
{%- capture pc -%}{% render 'at-pro-config' %}{%- endcapture -%}
{%- capture tier -%}{% render 'at-member-tier' %}{%- endcapture -%}
{%- liquid
  assign tier = tier | strip
  assign promise = pc | split: ';promise=' | last | split: ';' | first
-%}
{%- unless tier == 'wholesale' -%}
{{ 'at-pro.css' | asset_url | stylesheet_tag }}
<div class="section section--page-width at-pro-page at-pro-section at-pro-versus">
  <div class="at-pro-section__head">
    <h2 class="at-pro-serif at-pro-section__heading">{{ section.settings.heading | escape }}</h2>
  </div>
  <div class="at-pro-versus__wrap">
    <table class="at-pro-table at-pro-versus__table">
      <thead>
        <tr>
          <th scope="col"><span class="visually-hidden">{{ 'at_pro.versus.benefit' | t }}</span></th>
          <th scope="col">{{ 'at_pro.versus.member' | t }}</th>
          <th scope="col" class="at-pro-table__pro">
            <span class="at-pro-versus__pro-head">{% render 'at-pro-emblem', size: 'sm' %}{{ 'at_pro.versus.pro' | t }}</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {%- for block in section.blocks -%}
          <tr class="{% if block.settings.difference %}at-pro-versus__row--difference{% else %}at-pro-versus__row--shared{% endif %}" {{ block.shopify_attributes }}>
            <th scope="row">{{ block.settings.label | escape }}</th>
            <td>{% render 'at-pro-tokens', text: block.settings.member %}</td>
            <td class="at-pro-table__pro">{% render 'at-pro-tokens', text: block.settings.pro %}</td>
          </tr>
        {%- endfor -%}
        {%- if promise != 'off' -%}
          <tr class="at-pro-versus__row--difference">
            <th scope="row">{{ 'at_pro.versus.promise' | t }}</th>
            <td>—</td>
            <td class="at-pro-table__pro">
              {{ 'at_pro.promise.chip_title' | t }}
              {%- if promise == 'preview' %} <span class="at-pro-draft">{{ 'at_pro.promise.draft' | t }}</span>{% endif -%}
            </td>
          </tr>
        {%- endif -%}
      </tbody>
    </table>
  </div>
</div>
{%- endunless -%}

{% schema %}
{
  "name": "Pro: Member vs. Pro",
  "tag": "section",
  "class": "at-pro-section-wrap",
  "settings": [
    { "type": "paragraph", "content": "Tokens: [fee] [cash_rate] [ship_max] [ship_min] [free_ship] [ship_year]. Keep to the benefits Pro adds; no Wholesale column." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Member vs. Pro" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Benefit", "default": "Benefit" },
        { "type": "text", "id": "member", "label": "Member", "default": "—" },
        { "type": "text", "id": "pro", "label": "Pro", "default": "Included" },
        { "type": "checkbox", "id": "difference", "label": "Pro difference", "default": false, "info": "Emphasize rows where Pro is better than Member." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pro: Member vs. Pro",
      "blocks": [
        { "type": "row", "settings": { "label": "Annual membership", "member": "Free", "pro": "[fee]" } },
        { "type": "row", "settings": { "label": "Everyday pricing", "member": "Member pricing", "pro": "Exclusive Pro pricing", "difference": true } },
        { "type": "row", "settings": { "label": "Threads Cash", "member": "—", "pro": "[cash_rate] back, available monthly", "difference": true } },
        { "type": "row", "settings": { "label": "Monthly shipping savings", "member": "—", "pro": "Up to [ship_max] off one order a month", "difference": true } },
        { "type": "row", "settings": { "label": "Favorites, bulk ordering and personalized shopping", "member": "Included", "pro": "Included" } },
        { "type": "row", "settings": { "label": "Free standard shipping", "member": "[free_ship]+", "pro": "[free_ship]+" } }
      ]
    }
  ]
}
{% endschema %}
