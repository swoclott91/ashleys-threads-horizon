{%- comment -%}
  Pro PDP section 3: "Calculate your annual savings", the expanded calculator. Same markup and
  math as the compact one above the fold (snippets/at-pro-calculator, assets/at-pro-value.js).
  Prefilled from the customer's own last-12-month average when that is larger than the illustration.
{%- endcomment -%}
{%- capture pv -%}{% render 'at-pro-value' %}{%- endcapture -%}
{%- liquid
  assign state = pv | split: ';state=' | last | split: ';' | first
  assign hint = pv | split: ';monthly_hint=' | last | split: ';' | first | plus: 0 | divided_by: 100
  assign monthly = section.settings.default_monthly
  assign personal = false
  if hint > monthly
    assign monthly = hint
    assign personal = true
  endif
-%}
{%- unless state == 'f' -%}
{{ 'at-pro.css' | asset_url | stylesheet_tag }}
<script src="{{ 'at-pro-value.js' | asset_url }}" type="module"></script>
<div class="section section--page-width at-pro-page at-pro-section at-pro-calculator-section" id="at-pro-calculator">
  <div class="at-pro-section__head">
    <h2 class="at-pro-serif at-pro-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.intro != blank -%}<p class="at-pro-section__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
  </div>
  <div class="at-pro-card at-pro-calculator-section__card">
    {% render 'at-pro-calculator',
      id: 'at-pro-full-calc',
      variant: 'expanded',
      monthly: monthly,
      restocks: section.settings.default_restocks,
      ship: section.settings.default_ship,
      personal: personal,
      max_monthly: 5000
    %}
  </div>
</div>
{%- endunless -%}

{% schema %}
{
  "name": "Pro: savings calculator",
  "tag": "section",
  "class": "at-pro-section-wrap",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Calculate your annual savings" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Include what you buy from other suppliers today. Enter your spending at our standard Member prices." },
    { "type": "range", "id": "default_monthly", "label": "Illustrative monthly spend", "min": 100, "max": 5000, "step": 50, "unit": "$", "default": 750 },
    { "type": "range", "id": "default_restocks", "label": "Illustrative restocks a month", "min": 0, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "default_ship", "label": "Illustrative shipping per restock", "min": 0, "max": 40, "step": 1, "unit": "$", "default": 12 }
  ],
  "presets": [{ "name": "Pro: savings calculator" }]
}
{% endschema %}
