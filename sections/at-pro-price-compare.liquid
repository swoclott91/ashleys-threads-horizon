{%- comment -%}
  Pro PDP section 2: "Better prices on the blanks you build your business with"
  (docs/pro-membership-pdp.md, "Price comparison").

  Actual catalog prices only. The theme never calculates or estimates a tier price:
  - Signed-in Members and Pros: <at-pro-price-compare> asks Wagner's signed app proxy route
    GET /apps/wagner/pro-compare for up to `max_products` variants where the customer's actual
    Member and Pro prices differ by at least `min_savings` percent. Wagner picks them (their
    purchases, then favorites, then recently viewed, then the curated collection), from the tier
    prices it publishes to the Shopify Member and Pro catalogs, and returns the figures to that
    customer only. The page HTML holds no tier prices, and nothing renders for search engines.
  - The route is a proposed Wagner integration (not live yet). Until it answers, or when it finds
    nothing worth showing, the section shows a non-numeric explanation instead of cards.
  - Guests: the same non-numeric explanation with a sign-in prompt, no products and no prices.
  - Wholesale: hidden.
  - Theme editor: a layout preview with sample figures (labeled, never rendered for shoppers).
{%- endcomment -%}
{%- capture tier -%}{% render 'at-member-tier' %}{%- endcapture -%}
{%- liquid
  assign tier = tier | strip
  assign priced = false
  if customer
    if tier == 'member' or tier == 'pro'
      assign priced = true
    endif
  endif
  assign preview_cards = false
  if request.design_mode and section.settings.editor_preview
    assign preview_cards = true
    assign priced = true
  endif
  assign return_to = request.path | url_encode
  assign login_url = routes.account_login_url | append: '?return_url=' | append: return_to
-%}
{%- unless tier == 'wholesale' -%}
{{ 'at-pro.css' | asset_url | stylesheet_tag }}
<div class="section section--page-width at-pro-page at-pro-section at-pro-compare" id="at-pro-price-compare">
  <div class="at-pro-section__head">
    <h2 class="at-pro-serif at-pro-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.intro != blank and priced -%}<p class="at-pro-section__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
  </div>

  {%- if priced -%}
    <script src="{{ 'at-pro-compare.js' | asset_url }}" type="module"></script>
    <at-pro-price-compare
      class="at-pro-compare__live"
      data-endpoint="/apps/wagner/pro-compare"
      data-limit="{{ section.settings.max_products }}"
      data-quantity="{{ section.settings.quantity }}"
      data-min-savings="{{ section.settings.min_savings }}"
      {%- if section.settings.curated != blank %} data-curated="{{ section.settings.curated.handle | escape }}"{% endif %}
      data-currency="{{ shop.currency }}"
      data-locale="{{ request.locale.iso_code }}"
      {%- if preview_cards %} data-preview{% endif %}
      aria-busy="true"
    >
      <p class="at-pro-compare__status" data-status>{{ 'at_pro.compare.loading' | t }}</p>
      <ul class="at-pro-price-cards" role="list" data-cards hidden></ul>
      <p class="at-pro-section__footnote" data-footnote hidden>{{ 'at_pro.compare.footnote' | t }}</p>
      <p class="at-pro-compare__fallback" data-fallback hidden>{{ 'at_pro.compare.fallback' | t }}</p>
      {%- if preview_cards -%}
        <p class="at-pro-draft at-pro-editor-note">{{ 'at_pro.compare.editor_pending' | t }}</p>
      {%- endif -%}

      <template data-card>
        <li class="at-pro-price-card">
          <a class="at-pro-price-card__media" data-link tabindex="-1" aria-hidden="true"><img data-image alt="" loading="lazy" width="160" height="160"></a>
          <div class="at-pro-price-card__body">
            <p class="at-pro-price-card__source" data-source></p>
            <h3 class="at-pro-price-card__title">
              <span class="at-pro-price-card__vendor" data-brand></span>
              <a data-link data-title></a>
            </h3>
            <p class="at-pro-price-card__variant" data-variant></p>
            <p class="at-pro-price-card__save">
              <span class="at-pro-figure at-pro-price-card__save-amount" data-save></span>
              <span class="at-pro-price-card__save-unit">{{ 'at_pro.compare.per_garment' | t }}</span>
              <span class="at-pro-price-card__percent" data-percent></span>
            </p>
            <dl class="at-pro-price-card__prices">
              <div class="at-pro-price-card__member"><dt><span aria-hidden="true">{{ 'at_pro.compare.member_price' | t }}</span><span class="visually-hidden">{{ 'at_pro.compare.member_price_label' | t }}</span></dt><dd data-member></dd></div>
              <div class="at-pro-price-card__pro"><dt><span aria-hidden="true">{{ 'at_pro.compare.pro_price' | t }}</span><span class="visually-hidden">{{ 'at_pro.compare.pro_price_label' | t }}</span></dt><dd data-pro></dd></div>
            </dl>
            <p class="at-pro-price-card__qty" data-qty-row>
              <span data-qty-label></span> <strong data-qty-save></strong>
            </p>
          </div>
        </li>
      </template>
      <script type="application/json" data-strings>
        {
          "save": {{ 'at_pro.compare.save_each' | t: amount: '[amount]' | json }},
          "percent": {{ 'at_pro.compare.percent_less' | t: percent: '[percent]' | json }},
          "order": {{ 'at_pro.compare.order_label' | t: quantity: '[quantity]' | json }},
          "variant": {{ 'at_pro.compare.variant' | t: color: '[color]', size: '[size]' | json }},
          "sources": {
            "ordered": {{ 'at_pro.compare.source_ordered' | t | json }},
            "favorite": {{ 'at_pro.compare.source_favorite' | t | json }},
            "recent": {{ 'at_pro.compare.source_recent' | t | json }},
            "curated": {{ 'at_pro.compare.source_curated' | t | json }}
          },
          "sample": {{ 'at_pro.compare.sample' | t | json }}
        }
      </script>
    </at-pro-price-compare>
  {%- else -%}
    <div class="at-pro-compare__guest">
      <p>{{ 'at_pro.compare.guest_body' | t }}</p>
      <a class="button-secondary" href="{{ login_url }}">{{ 'at_pro.compare.guest_cta' | t }}</a>
    </div>
  {%- endif -%}
</div>
{%- endunless -%}

{% schema %}
{
  "name": "Pro: price comparison",
  "tag": "section",
  "class": "at-pro-section-wrap",
  "settings": [
    { "type": "paragraph", "content": "Signed-in Members and Pros see their actual Member and Pro prices, from Wagner’s signed price comparison route. Guests see a sign-in prompt and no prices. Nothing is estimated in the theme: when actual prices aren’t available the section shows a short explanation instead of cards." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Better prices on the blanks you build your business with." },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Your Member and Pro prices, side by side, on styles you know.", "info": "Signed-in customers only." },
    { "type": "collection", "id": "curated", "label": "Curated Pro picks", "info": "Used after a customer’s own purchases, favorites and recently viewed styles. Choose styles across the assortment where Pro has a real advantage (premium fleece, specialty tees, polos, performance, workwear). A style is shown only when its actual Pro saving meets the minimum below." },
    { "type": "range", "id": "min_savings", "label": "Minimum Pro saving", "min": 1, "max": 20, "step": 1, "unit": "%", "default": 5, "info": "Pending validation. Wagner may apply a higher floor of its own." },
    { "type": "range", "id": "max_products", "label": "Styles to show", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "quantity", "label": "Representative quantity", "min": 12, "max": 288, "step": 12, "default": 72 },
    { "type": "checkbox", "id": "editor_preview", "label": "Show sample cards in the theme editor", "default": true, "info": "Layout preview with sample figures. Never shown to shoppers." }
  ],
  "presets": [{ "name": "Pro: price comparison" }]
}
{% endschema %}
