{%- comment -%}
  Ashley's Pro membership PDP, above the fold (docs/pro-membership-pdp.md).
  Left: the burgundy membership card. Prospective Pros (states a–d) all see the same offer, no
  interaction needed: exclusive Pro pricing first, then Threads Cash and the monthly shipping credit
  side by side, and "plus everything in your free membership". Eligibility details live further
  down the page (rewards section, FAQ). Members with meaningful history get one personal line;
  nothing on the page depends on it. Active Pros (e) see their operational benefits; Wholesale (f)
  sees its account.
  Right: title and the annual fee, the action (snippets/at-pro-cta), the billing note and the
  compact Pro Promise. The card already names every benefit, so there is no second benefits list.
  Mobile order: title and price (one row) → card → button → billing note → Promise chip, sized so
  the button is inside the first screen at 390×844 and 375×667 (docs: mobile above the fold).
  The sticky bar takes over once the button scrolls away.

  Personal line (states b–d), most specific first, and only where the data supports it:
  1. "You could have saved an additional $X with Pro pricing on your orders [period]": Wagner's
     pricing figure, at least Theme settings › Membership › Smallest personal estimate, exact
     (not estimated) prices, and a known period.
  2. "Based on your orders over the past year, Pro could be a great fit": states c and d, or a year
     of orders whose Threads Cash at the Pro rate alone would cover the fee.
  When an authoritative cart comparison exists, "save $X on this order" takes priority over both
  (docs: cart upsell). Pricing savings never count toward the Pro Promise.
{%- endcomment -%}
{%- liquid
  assign pro_product = product | default: settings.at_pro_product
  assign preview = 'off'
  if request.design_mode
    assign preview = section.settings.preview_state
  endif
-%}
{%- capture pv -%}{% render 'at-pro-value', preview: preview %}{%- endcapture -%}
{%- capture pc -%}{% render 'at-pro-config' %}{%- endcapture -%}
{%- liquid
  assign state = pv | split: ';state=' | last | split: ';' | first
  assign sample = pv | split: ';sample=' | last | split: ';' | first | plus: 0
  assign basis = pv | split: ';basis=' | last | split: ';' | first
  assign v_pricing = pv | split: ';pricing=' | last | split: ';' | first | plus: 0
  assign v_cash = pv | split: ';cash=' | last | split: ';' | first | plus: 0
  assign v_ship = pv | split: ';ship=' | last | split: ';' | first | plus: 0
  assign v_fee = pv | split: ';fee=' | last | split: ';' | first | plus: 0
  assign v_spend = pv | split: ';spend_12m=' | last | split: ';' | first | plus: 0
  assign v_balance = pv | split: ';balance=' | last | split: ';' | first | plus: 0
  assign v_renew = pv | split: ';renew=' | last | split: ';' | first
  assign v_ship_status = pv | split: ';ship_status=' | last | split: ';' | first
  assign v_ship_code = pv | split: ';ship_code=' | last | split: ';' | first
  assign v_exact = pv | split: ';exact=' | last | split: ';' | first | plus: 0
  assign v_qualifying = pv | split: ';qualifying=' | last | split: ';' | first | plus: 0
  assign v_qualifying_bp = pv | split: ';qualifying_bp=' | last | split: ';' | first | plus: 0

  assign c_cash_bp = pc | split: ';cash_bp=' | last | split: ';' | first | plus: 0
  assign c_member_cash_bp = pc | split: ';member_cash_bp=' | last | split: ';' | first | plus: 0
  assign c_ship_max = pc | split: ';ship_max=' | last | split: ';' | first | plus: 0
  assign c_ship_min = pc | split: ';ship_min=' | last | split: ';' | first | plus: 0
  assign c_history_min = pc | split: ';history_min=' | last | split: ';' | first | plus: 0
  assign c_promise = pc | split: ';promise=' | last | split: ';' | first

  assign cash_pct = c_cash_bp | minus: c_member_cash_bp | times: 1.0 | divided_by: 100 | round: 1 | append: '' | remove: '.0' | append: '%'
  assign ship_max_money = c_ship_max | money_without_trailing_zeros
  assign ship_min_money = c_ship_min | money_without_trailing_zeros
  assign fee_money = v_fee | money_without_trailing_zeros

  # Whole dollars.
  assign pricing_round = v_pricing | plus: 50 | divided_by: 100 | times: 100
  assign cash_round = v_cash | plus: 50 | divided_by: 100 | times: 100
  assign ship_round = v_ship | plus: 50 | divided_by: 100 | times: 100
  assign balance_round = v_balance | plus: 50 | divided_by: 100 | times: 100
  assign qualifying_round = v_qualifying | plus: 50 | divided_by: 100 | times: 100
  assign qualifying_pct = v_qualifying_bp | divided_by: 100
  assign progress = v_qualifying_bp | at_most: 10000 | times: 1.0 | divided_by: 10000

  case basis
    when 'trailing_12m'
      assign period_text = 'at_pro.period.trailing_12m' | t
    when 'calendar_ytd'
      assign period_text = 'at_pro.period.calendar_ytd' | t
    else
      assign period_text = ''
  endcase

  # Personal line for Members (see the comment above).
  assign personal_text = ''
  if state == 'b' or state == 'c' or state == 'd'
    if v_pricing >= c_history_min and v_exact == 1 and period_text != blank
      assign pricing_money = pricing_round | money_without_trailing_zeros
      assign personal_text = 'at_pro.personal.saved' | t: amount: pricing_money, period: period_text
    else
      assign cover_spend = 0
      if c_cash_bp > 0
        assign cover_spend = v_fee | times: 10000 | divided_by: c_cash_bp
      endif
      if state == 'c' or state == 'd' or v_spend >= cover_spend and cover_spend > 0
        assign personal_text = 'at_pro.personal.fit' | t
      endif
    endif
  endif

  case state
    when 'e'
      assign headline = section.settings.headline_e
    when 'f'
      assign headline = section.settings.headline_f
    else
      assign headline = section.settings.headline
  endcase

  if basis == 'membership_year'
    assign cash_label = 'at_pro.member.cash_issued' | t
    assign ship_label = 'at_pro.member.shipping' | t
  else
    assign cash_label = 'at_pro.member.cash_issued_ytd' | t
    assign ship_label = 'at_pro.member.shipping_ytd' | t
  endif

  assign restock_url = settings.at_pro_restock_url | default: routes.all_products_collection_url
-%}

{{ 'at-pro.css' | asset_url | stylesheet_tag }}
<script src="{{ 'at-pro-sticky.js' | asset_url }}" type="module"></script>
{% style %}
  {{ settings.at_editorial_serif_font | font_face: font_display: 'swap' }}
  .at-pro-page { --at-pro-serif: {{ settings.at_editorial_serif_font.family }}, {{ settings.at_editorial_serif_font.fallback_families }}; }
  main:has(.at-pro-page) { background: var(--at-membership-surface); }
{% endstyle %}

<div class="section section--page-width at-pro-page at-pro-hero at-pro-hero--state-{{ state }}" data-pro-state="{{ state }}">
  <div class="at-pro-hero__grid">
    {%- comment -%} Title and price: first on mobile, top of the right column on desktop {%- endcomment -%}
    <header class="at-pro-hero__identity">
      <h1 class="at-pro-hero__title">{{ pro_product.title | default: section.settings.fallback_title | escape }}</h1>
      {%- unless state == 'e' or state == 'f' -%}
        <p class="at-pro-hero__price">
          <span class="at-pro-figure at-pro-hero__price-amount">{{ fee_money }}</span>
          <span class="at-pro-hero__price-unit">{{ 'at_pro.price.per_year_suffix' | t }}</span>
        </p>
      {%- endunless -%}
    </header>

    {%- comment -%} Membership card {%- endcomment -%}
    <div class="at-pro-panel at-pro-panel--{{ state }}">
      {%- if sample == 1 -%}
        <p class="at-pro-panel__sample">{{ 'at_pro.sample' | t }} · {% case state %}{% when 'a' %}{{ 'at_pro.states.a' | t }}{% when 'b' %}{{ 'at_pro.states.b' | t }}{% when 'c' %}{{ 'at_pro.states.c' | t }}{% when 'd' %}{{ 'at_pro.states.d' | t }}{% when 'e' %}{{ 'at_pro.states.e' | t }}{% else %}{{ 'at_pro.states.f' | t }}{% endcase %}{% if basis == 'calendar_ytd' %} · {{ 'at_pro.states.ytd' | t }}{% endif %}</p>
      {%- endif -%}
      <div class="at-pro-panel__brand">
        {% render 'at-pro-emblem', size: 'lg', inverse: true %}
        <div class="at-pro-panel__brand-text">
          <p class="at-pro-kicker at-pro-kicker--inverse">{{ 'at_pro.kicker' | t }}</p>
          <h2 class="at-pro-panel__headline at-pro-serif">{{ headline | escape }}</h2>
        </div>
      </div>

      {%- case state -%}
        {%- when 'e' -%}
          {%- if v_qualifying > 0 and basis != 'none' -%}
            <p class="at-pro-figure-block">
              <span class="at-pro-figure-block__label">
                {%- if basis == 'membership_year' -%}{{ 'at_pro.member.qualifying' | t }}{%- else -%}{{ 'at_pro.member.qualifying_ytd' | t }}{%- endif -%}
              </span>
              <span class="at-pro-figure at-pro-figure--hero">{{ qualifying_round | money_without_trailing_zeros }}</span>
            </p>
            {%- if basis == 'membership_year' and v_fee > 0 -%}
              {%- if v_qualifying >= v_fee -%}
                <p class="at-pro-conclusion at-pro-conclusion__success">{{ 'at_pro.member.covered_full' | t: fee: fee_money }}</p>
              {%- else -%}
                <div class="at-pro-progress" style="--at-pro-progress: {{ progress }}" role="img" aria-label="{{ 'at_pro.member.progress_aria' | t: percent: qualifying_pct }}">
                  <span class="at-pro-progress__bar"></span>
                </div>
                <p class="at-pro-conclusion">{{ 'at_pro.member.covered' | t: percent: qualifying_pct, fee: fee_money }}</p>
                {%- if c_promise != 'off' -%}
                  <p class="at-pro-panel__note">
                    {{ 'at_pro.member.promise_note' | t }}
                    {%- if c_promise == 'preview' %} <span class="at-pro-draft at-pro-draft--inverse">{{ 'at_pro.promise.draft' | t }}</span>{% endif -%}
                  </p>
                {%- endif -%}
              {%- endif -%}
            {%- elsif basis == 'calendar_ytd' -%}
              <p class="at-pro-panel__note">{{ 'at_pro.member.ytd_note' | t }}</p>
            {%- endif -%}
          {%- else -%}
            <p class="at-pro-panel__lead">{{ 'at_pro.member.empty' | t }}</p>
          {%- endif -%}

          {%- if v_ship_status == 'ready' -%}
            <div class="at-pro-credit">
              <p class="at-pro-credit__title">{{ 'at_pro.member.ship_ready_title' | t: max: ship_max_money }}</p>
              <p class="at-pro-credit__body">
                {{ 'at_pro.member.ship_ready_body' | t: min: ship_min_money }}
                {%- if v_ship_code != blank %} <code>{{ v_ship_code }}</code>{% endif -%}
              </p>
              <a class="button-secondary at-pro-credit__action" href="{{ restock_url }}">{{ 'at_pro.member.ship_ready_cta' | t }}</a>
            </div>
          {%- endif -%}

          <dl class="at-pro-facts">
            {%- if v_balance >= 0 -%}
              <div><dt>{{ 'at_pro.member.balance' | t }}</dt><dd>{{ balance_round | money_without_trailing_zeros }}</dd></div>
            {%- endif -%}
            {%- if v_cash >= 0 -%}
              <div><dt>{{ cash_label }}</dt><dd>{{ cash_round | money_without_trailing_zeros }}</dd></div>
            {%- endif -%}
            {%- if v_ship >= 0 -%}
              <div><dt>{{ ship_label }}</dt><dd>{{ ship_round | money_without_trailing_zeros }}</dd></div>
            {%- endif -%}
            {%- unless v_ship_status == 'ready' -%}
              <div>
                <dt>{{ 'at_pro.member.ship_credit' | t }}</dt>
                <dd>
                  {%- if v_ship_status == 'used' -%}{{ 'at_pro.member.ship_used' | t }}{%- else -%}{{ 'at_pro.member.ship_none' | t }}{%- endif -%}
                </dd>
              </div>
            {%- endunless -%}
            {%- if v_renew != blank -%}
              <div><dt>{{ 'at_pro.member.active_through' | t }}</dt><dd>{{ v_renew | date: '%B %-d, %Y' }}</dd></div>
            {%- endif -%}
          </dl>

        {%- when 'f' -%}
          <p class="at-pro-panel__lead">{{ section.settings.lead_f | escape }}</p>
          <a class="button-secondary at-pro-panel__wholesale" href="{{ settings.at_wholesale_page_url | default: routes.account_url }}">{{ 'at_pro.wholesale.benefits' | t }}</a>

        {%- else -%}
          <div class="at-pro-offer">
            <p class="at-pro-offer__primary">
              <span class="at-pro-offer__title at-pro-serif">{{ 'at_pro.offer.pricing_title' | t }}</span>
              <span class="at-pro-offer__detail">{{ 'at_pro.offer.pricing_detail' | t }}</span>
            </p>
            <ul class="at-pro-offer__stats" role="list">
              <li class="at-pro-offer__stat">
                <span class="at-pro-figure at-pro-offer__number">{{ cash_pct }}</span>
                <span class="at-pro-offer__unit">{{ 'at_pro.offer.cash_unit' | t }}</span>
              </li>
              <li class="at-pro-offer__stat">
                <span class="at-pro-offer__number-row"><span class="at-pro-offer__pre">{{ 'at_pro.offer.up_to' | t }}</span> <span class="at-pro-figure at-pro-offer__number">{{ ship_max_money }}</span></span>
                <span class="at-pro-offer__unit">{{ 'at_pro.offer.ship_unit_monthly' | t }}</span>
              </li>
            </ul>
            <p class="at-pro-offer__plus">{{ 'at_pro.offer.plus_member' | t }}</p>
          </div>
          {%- if personal_text != blank -%}
            <p class="at-pro-panel__personal">{{ personal_text }}</p>
          {%- endif -%}
      {%- endcase -%}
    </div>

    {%- comment -%} Purchase panel {%- endcomment -%}
    <div class="at-pro-hero__purchase">
      {%- if state == 'e' -%}
        <p class="at-pro-hero__tagline at-pro-serif">{{ 'at_pro.member.tagline' | t }}</p>
      {%- elsif state == 'f' -%}
        <p class="at-pro-hero__tagline at-pro-serif">{{ 'at_pro.wholesale.tagline' | t }}</p>
        <p class="at-pro-hero__value-prop">{{ 'at_pro.wholesale.description' | t }}</p>
      {%- endif -%}


      <div class="at-pro-hero__actions">
        {% render 'at-pro-cta', product: pro_product, state: state, label: section.settings.cta_label, with_price: true, id: 'AtProPrimaryCta', form_id: 'AtProHeroForm' %}
        {%- unless state == 'e' or state == 'f' -%}
          <p class="at-pro-hero__fine">
            {{ section.settings.billing_note | escape }}
            {%- unless customer %} {{ 'at_pro.cta.sign_in_note' | t }}{% endunless -%}
          </p>
        {%- endunless -%}
      </div>

      {%- if c_promise != 'off' and state != 'e' and state != 'f' -%}
        <div class="at-pro-promise-chip">
          {%- if c_promise == 'preview' -%}
            <span class="at-pro-draft">{{ 'at_pro.promise.draft' | t }}</span>
          {%- endif -%}
          {% render 'at-pro-emblem', size: 'sm' %}
          <p>
            <strong>{{ 'at_pro.promise.chip_title' | t }}</strong>
            {{ 'at_pro.promise.chip_body' | t }}
            {%- if settings.at_pro_promise_terms_url != blank %} <a href="{{ settings.at_pro_promise_terms_url }}">{{ 'at_pro.promise.terms' | t }}</a>{% endif -%}
          </p>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.sticky_bar and state != 'e' and state != 'f' -%}
    <at-pro-sticky-bar class="at-pro-sticky" data-target="AtProPrimaryCta" data-guard=".at-pro-hero__purchase">
      <span class="at-pro-sticky__price">
        <span class="at-pro-figure">{{ fee_money }}</span>{{ 'at_pro.price.per_year_suffix' | t }}
      </span>
      {% render 'at-pro-cta', product: pro_product, state: state, label: section.settings.cta_label, form_id: 'AtProStickyForm' %}
    </at-pro-sticky-bar>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Pro membership hero",
  "tag": "section",
  "class": "at-pro-hero-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "select",
      "id": "preview_state",
      "label": "Theme editor preview",
      "info": "Labeled sample data for each customer state. Shoppers always see their own state.",
      "options": [
        { "value": "auto", "label": "Signed-in customer / Preview tier" },
        { "value": "a", "label": "A · No purchase history" },
        { "value": "b", "label": "B · Limited history" },
        { "value": "c", "label": "C · Member, history below the fee" },
        { "value": "d", "label": "D · Member, history above the fee" },
        { "value": "d_ytd", "label": "D · Member, this year’s pricing figure" },
        { "value": "e", "label": "E · Active Pro, below the fee" },
        { "value": "e_full", "label": "E · Active Pro, fee covered" },
        { "value": "e_ytd", "label": "E · Active Pro (calendar-year data)" },
        { "value": "f", "label": "F · Wholesale" }
      ],
      "default": "auto"
    },
    { "type": "text", "id": "fallback_title", "label": "Title when no product", "default": "Ashley’s Pro Membership" },
    { "type": "header", "content": "Membership card" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Make more. Keep more.", "info": "Guests and Members." },
    { "type": "text", "id": "headline_e", "label": "Headline for Pro members", "default": "Your Pro membership at work." },
    { "type": "text", "id": "headline_f", "label": "Headline for Wholesale", "default": "You already have wholesale pricing." },
    { "type": "textarea", "id": "lead_f", "label": "Wholesale text", "default": "Your wholesale account has its own pricing and terms, so there’s nothing more to add here." },
    { "type": "header", "content": "Purchase panel" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Become a Pro", "info": "The annual fee and “/year” are added automatically." },
    { "type": "textarea", "id": "billing_note", "label": "Billing note", "default": "One payment. 12 months of benefits.", "info": "Pro is a one-time annual purchase today. Don’t describe automatic renewal until it exists." },
    { "type": "checkbox", "id": "sticky_bar", "label": "Mobile sticky purchase bar", "default": true }
  ],
  "presets": [{ "name": "Pro membership hero" }]
}
{% endschema %}
