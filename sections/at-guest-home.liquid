{%- capture home_tier -%}{% render 'at-member-tier' %}{%- endcapture -%}
{%- assign home_tier = home_tier | strip -%}
<div class="section-background at-guest-home__background"></div>
<div class="section section--page-width at-guest-home">
  <div class="at-guest-home__intro">
    {% content_for 'block', type: 'text', id: 'heading' %}
    {% content_for 'block', type: 'text', id: 'intro' %}
  </div>
  <div class="at-guest-home__grid{% if home_tier != 'guest' %} at-guest-home__grid--member{% endif %}">
    {%- capture personal_styles -%}
      {%- if home_tier != 'guest' -%}
        {%- render 'at-home-bulk-thumbnails' -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- assign personal_styles = personal_styles | strip -%}
    <div class="at-member-home__bulk">
      <h2 class="h2">{{ 'at_member_home.bulk.heading' | t }}</h2>
      {%- if personal_styles != blank -%}
        <p>{{ 'at_member_home.bulk.description' | t }}</p>
        {{ personal_styles }}
      {%- else -%}
        <p>{{ 'at_member_home.bulk.starter_description' | t }}</p>
        {% render 'at-home-bulk-thumbnails', starter_only: true, starter_products: section.settings.bulk_starter_products %}
      {%- endif -%}
      <p class="at-member-home__bulk-detail">{{ 'at_member_home.bulk.detail' | t }}</p>
      {%- assign bulk_order_url = pages['bulk-order'].url -%}
      {%- if bulk_order_url != blank -%}
        <a class="{% if home_tier == 'guest' %}button{% else %}button-secondary{% endif %} at-member-home__bulk-cta" href="{{ bulk_order_url }}">
          {{ 'at-bulk-favorite.svg' | inline_asset_content }}
          {%- if home_tier != 'guest' -%}
            {{- 'at_member_home.bulk.cta' | t -}}
          {%- else -%}
            {{- 'at_member_home.bulk.guest_cta' | t -}}
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
    <div class="at-guest-home__membership{% if home_tier == 'member' %} at-member-home__upgrade{% endif %}">
      <span class="at-guest-home__membership-monogram" aria-hidden="true">
        {{- 'at-monogram.svg' | inline_asset_content -}}
      </span>
      {%- case home_tier -%}
        {%- when 'member' -%}
          {% content_for 'block', type: 'group', id: 'pro' %}
        {%- when 'pro', 'wholesale' -%}
          {% render 'at-home-tier-benefits', tier: home_tier %}
        {%- else -%}
          {% content_for 'block', type: 'group', id: 'membership' %}
      {%- endcase -%}
    </div>
    {%- if home_tier != 'guest' -%}
      <div class="at-guest-home__recent at-member-home__tile">
        <h2 class="h4">{{ 'at_member_home.recent.heading' | t }}</h2>
        <at-home-recently-viewed data-search-url="{{ routes.search_url }}">
          {%- assign recent_sample = false -%}
          {%- if request.design_mode and section.settings.preview_recent_products != blank -%}
            {%- assign recent_sample = true -%}
          {%- endif -%}
          <ul role="list" data-recent-items{% unless recent_sample %} hidden{% endunless %}>
            {%- if recent_sample -%}
              {%- for preview_product in section.settings.preview_recent_products -%}
                {%- assign preview_style = preview_product.title | strip | split: ' ' | first -%}
                <li>
                  <a class="at-member-home__viewed-link" href="{{ preview_product.url }}">
                    {%- if preview_product.featured_image -%}
                      {{
                        preview_product.featured_image
                        | image_url: width: 400
                        | image_tag: widths: '120, 240, 400', sizes: '(min-width: 750px) 13vw, 45vw', alt: ''
                      }}
                    {%- endif -%}
                    <span class="at-member-home__viewed-caption">
                      {% if preview_product.vendor != blank %}{{ preview_product.vendor | escape }} {% endif -%}
                      {{- preview_style | escape }}
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
          <p data-recent-empty{% if recent_sample %} data-recent-sample{% endif %}>
            {%- if recent_sample -%}{{ 'at_member_home.sample' | t }}{%- else -%}{{ 'at_member_home.recent.empty' | t }}{%- endif -%}
          </p>
        </at-home-recently-viewed>
        <script src="{{ 'at-home-recently-viewed.js' | asset_url }}" type="module" fetchpriority="low"></script>
      </div>
    {%- else -%}
      <div class="at-guest-home__categories">
        <div class="at-guest-home__category">
          {% content_for 'block', type: 'group', id: 'tees' %}
        </div>
        <div class="at-guest-home__category at-guest-home__fleece">
          {% content_for 'block', type: 'group', id: 'fleece' %}
        </div>
      </div>
    {%- endif -%}
    <div class="at-guest-home__seasonal">
      {% content_for 'block', type: 'group', id: 'seasonal' %}
    </div>
  </div>
</div>

{% style %}
  main:has(.at-guest-home) {
    --at-home-forest: {{ settings.color_palette.color5 }};
    --at-home-forest-rgb: {{ settings.color_palette.color5.rgb }};
    --at-home-cream: {{ settings.color_palette.color12 }};
    --at-home-cream-rgb: {{ settings.color_palette.color12.rgb }};
    --at-home-burgundy: {{ settings.color_palette.color13 | default: '#6c2639' }};
    --at-home-neutral: {{ settings.color_palette.color3 }};
    --at-home-border: {{ settings.color_palette.color4 }};
    --at-home-background: color-mix(in srgb, var(--at-home-cream) 76%, var(--at-home-neutral));
    --at-home-card: color-mix(in srgb, var(--at-home-cream) 40%, var(--at-home-neutral));
    --at-home-olive: color-mix(in srgb, var(--at-home-cream) 82%, {{ settings.color_palette.color7 }});
    --at-home-radius: var(--style-border-radius-md);
    --at-home-gap: var(--gap-sm);
    --at-home-section-space: var(--padding-sm);
    --at-home-card-padding: var(--padding-lg);
    background-color: var(--at-home-background);
  }

  @media screen and (min-width: 990px) {
    main:has(.at-guest-home) {
      --at-home-section-space: var(--padding-lg);
      --at-home-card-padding: var(--padding-2xl);
    }
  }

  .at-guest-home__background { background-color: var(--at-home-background); }
  .at-guest-home { padding-block: var(--at-home-section-space); }

  .at-guest-home__intro {
    display: grid;
    gap: var(--gap-2xs);
    margin-block-end: var(--at-home-section-space);
  }

  .at-guest-home__intro .text-block.h3,
  .at-guest-home__seasonal .text-block.h4,
  .at-guest-home__category .text-block.h5,
  .at-member-home__tile {
    --color: var(--at-home-forest);
  }

  .at-guest-home__grid h2 { overflow-wrap: anywhere; }

  .at-guest-home__grid {
    display: grid;
    gap: var(--at-home-gap);
    grid-template-areas: "bulk" "membership" "discovery" "seasonal";
    grid-template-columns: minmax(0, 1fr);
  }

  .at-guest-home__seasonal {
    grid-area: seasonal;
    min-block-size: 185px;
    min-width: 0;
  }

  .at-guest-home__membership {
    --membership-background: var(--at-home-forest);
    --monogram-size: clamp(40px, 4.6vw, 64px);
    --monogram-inset: var(--at-home-card-padding);
    position: relative;
    isolation: isolate;
    grid-area: membership;
    min-width: 0;
  }

  .at-guest-home__membership:has(.at-home-tier-benefits--pro),
  .at-member-home__upgrade { --membership-background: var(--at-home-burgundy); }

  .at-guest-home__membership:has(.at-home-tier-benefits--wholesale) {
    --membership-background: {{ settings.color_palette.color7 }};
  }

  .at-guest-home__membership::after {
    position: absolute;
    z-index: 1;
    inset: var(--padding-xs);
    border: 2px dashed rgb(var(--at-home-cream-rgb) / 0.85);
    border-radius: max(var(--style-border-radius-xs), calc(var(--at-home-radius) - var(--padding-2xs)));
    content: '';
    pointer-events: none;
  }

  .at-guest-home__membership > :is(.group-block, .at-home-tier-benefits) {
    --color: var(--at-home-cream);
    --color-foreground: var(--at-home-cream);
    --color-foreground-rgb: var(--at-home-cream-rgb);
    --color-border: rgb(var(--at-home-cream-rgb) / var(--opacity-50));
    padding: var(--at-home-card-padding);
    padding-inline: max(var(--at-home-card-padding), var(--padding-xl));
    padding-block-start: calc(var(--monogram-inset) + 1.21 * var(--monogram-size) + var(--gap-sm));
    background-color: var(--membership-background);
    color: var(--color-foreground);
  }

  .at-guest-home__membership-monogram {
    position: absolute;
    z-index: 1;
    inset-block-start: var(--monogram-inset);
    inset-inline-end: var(--monogram-inset);
    inline-size: var(--monogram-size);
    color: var(--at-home-cream);
    pointer-events: none;
  }

  .at-guest-home__membership-monogram svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .at-guest-home__membership h2,
  .at-guest-home__membership p {
    margin-block: 0;
    overflow-wrap: anywhere;
  }

  .at-guest-home__membership .icon-block__media { flex-shrink: 0; }
  .at-guest-home__membership .group-block-content > .group-block,
  .at-guest-home__membership .group-block-content .text-block { min-width: 0; }

  .at-guest-home__recent,
  .at-guest-home__categories { grid-area: discovery; min-width: 0; }

  .at-guest-home__categories {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--at-home-gap);
  }

  .at-guest-home__category { min-block-size: 145px; }

  .at-guest-home__grid > div > .group-block,
  .at-guest-home__category > .group-block {
    height: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .at-guest-home__grid > div > .group-block,
  .at-guest-home__category > .group-block,
  .at-member-home__bulk,
  .at-member-home__tile,
  .at-home-tier-benefits,
  [id$="__at_guest_featured"] .product-card,
  [id$="__at_guest_demo"] .section-content-wrapper > .group-block {
    border: var(--style-border-width) solid var(--at-home-border);
    border-radius: var(--at-home-radius);
  }

  .at-guest-home__seasonal > .group-block {
    padding: var(--at-home-card-padding);
    background-color: var(--at-home-card);
  }

  .at-guest-home__seasonal > .group-block > .group-block-content,
  .at-guest-home__category > .group-block > .group-block-content { height: 100%; }

  .at-guest-home__seasonal .button,
  .at-guest-home__category .button-link { margin-block-start: auto; }

  .at-guest-home__seasonal .group-block__media-wrapper::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--at-home-background), color-mix(in srgb, var(--at-home-background) 82%, transparent) 45%, transparent 85%);
    content: '';
  }

  .at-guest-home__seasonal h2 { max-width: 12ch; margin-block: 0; }
  .at-guest-home__seasonal p,
  .at-home-tier-benefits__kicker {
    margin-block: 0;
    font-size: var(--font-h6--size);
    line-height: var(--font-h6--line-height);
  }

  .at-guest-home__category > .group-block {
    --color-foreground: var(--at-home-forest);
    --color-foreground-rgb: var(--at-home-forest-rgb);
    padding: var(--padding-sm);
    background-color: var(--at-home-neutral);
  }

  .at-guest-home__fleece > .group-block { background-color: var(--at-home-olive); }
  .at-guest-home__category .background-image-container { inset: 0; }
  .at-guest-home__category .group-block__media-wrapper { mix-blend-mode: multiply; }
  .at-guest-home__category .group-block__media-wrapper img {
    object-fit: contain;
    object-position: center;
    padding-block: calc(var(--font-h5--size) + var(--padding-lg)) var(--padding-4xl);
  }

  .at-guest-home__category .button-link {
    font-size: var(--font-size--sm);
    line-height: var(--line-height--body-normal);
  }

  @media screen and (min-width: 750px) {
    .at-guest-home__grid {
      grid-template-areas: "bulk membership discovery" "bulk membership seasonal";
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr) minmax(0, .87fr);
      grid-template-rows: auto auto;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1099px) {
    .at-guest-home__categories { grid-template-columns: minmax(0, 1fr); }
    .at-guest-home__category { min-block-size: 120px; }
    .at-guest-home__seasonal > .group-block { padding: var(--padding-lg); }
  }

  [id$="__at_guest_featured"] :is(.resource-list__item, .product-card, .product-card__content) {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  [id$="__at_guest_featured"] .section-background,
  [id$="__at_guest_demo"] .section-background { background-color: var(--at-home-background); }

  [id$="__at_guest_featured"] slideshow-container { background-color: transparent; }

  [id$="__at_guest_featured"] .text-block.h3,
  [id$="__at_guest_demo"] .text-block.h2 { --color: var(--at-home-forest); }

  [id$="__at_guest_featured"] h2,
  [id$="__at_guest_demo"] h2 { margin-block: 0; }

  [id$="__at_guest_featured"] .product-card {
    background-color: var(--at-home-card);
    overflow: hidden;
  }

  [id$="__at_guest_featured"] .image-block {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio);
    min-height: 0;
    flex: none;
    overflow: hidden;
    background-color: var(--at-home-neutral);
  }

  [id$="__at_guest_featured"] .image-block__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  [id$="__at_guest_featured"] .product-card .text-block p { min-block-size: 2lh; }

  [id$="__at_guest_demo"] .section-content-wrapper > .group-block {
    background-color: var(--at-home-olive);
  }

  [id$="__at_guest_demo"] deferred-media {
    border: var(--style-border-width) solid var(--at-home-border);
    border-radius: var(--at-home-radius);
  }

  .at-member-home__tile {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--at-home-gap);
    padding: var(--at-home-card-padding);
    background: var(--at-home-card);
  }

  .at-member-home__tile :is(h2, p),
  .at-member-home__bulk :is(h2, p) { margin: 0; }

  .at-member-home__bulk {
    --color: var(--at-home-forest);
    --bulk-background: var(--at-home-card);
    position: relative;
    isolation: isolate;
    grid-area: bulk;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--at-home-gap);
    min-width: 0;
    min-block-size: clamp(270px, 35vw, 440px);
    padding: var(--at-home-card-padding);
    background-color: var(--bulk-background);
    color: var(--color);
  }

  .at-guest-home__grid--member .at-member-home__bulk {
    --color: var(--at-home-cream);
    --bulk-background: var(--at-home-forest);
  }

  .at-member-home__bulk h2 {
    max-width: 15ch;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .at-member-home__bulk-detail {
    font-size: var(--font-size--sm);
    line-height: var(--line-height--body-normal);
  }

  .at-member-home__bulk-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-xs);
    min-height: var(--button-size);
    max-width: 100%;
    margin-block-start: auto;
  }

  .at-member-home__bulk-cta::after {
    position: absolute;
    inset: 0;
    border-radius: var(--at-home-radius);
    content: '';
  }

  .at-member-home__bulk-cta:focus-visible { outline: none; }
  .at-member-home__bulk-cta:focus-visible::after {
    outline: var(--focus-outline-width) solid var(--color);
    outline-offset: calc(-1 * var(--padding-2xs));
  }

  .at-member-home__bulk-cta svg { flex: none; }

  .at-member-home__bulk-thumbnails,
  at-home-recently-viewed ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .at-member-home__bulk-thumbnails,
  at-home-recently-viewed ul:not([hidden]) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-xs);
    align-self: stretch;
  }

  at-home-recently-viewed ul:not([hidden]) {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 4rem), 1fr));
  }

  .at-member-home__bulk-thumbnails a,
  .at-member-home__viewed-link {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: var(--gap-2xs);
    height: 100%;
    padding: var(--padding-xs);
    border: var(--style-border-width) solid var(--at-home-border);
    border-radius: var(--at-home-radius);
    background-color: var(--at-home-background);
    color: var(--at-home-forest);
    font-size: var(--font-h6--size);
    line-height: var(--font-h6--line-height);
    text-align: center;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .at-member-home__bulk-thumbnails a { position: relative; z-index: 1; }
  .at-member-home__bulk-thumbnails a:hover,
  .at-member-home__viewed-link:hover { text-decoration: underline; }

  .at-member-home__bulk-thumbnails a:focus-visible {
    outline-color: var(--color);
  }

  .at-member-home__bulk-thumbnails img,
  .at-member-home__viewed-link img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    object-position: center;
    mix-blend-mode: multiply;
  }

  .at-member-home__viewed-caption { grid-row: 2; }

  .at-home-pro,
  .at-home-tier-benefits__cash { display: grid; gap: var(--gap-2xs); }
  .at-home-pro { gap: var(--at-home-gap); }

  .at-home-pro__amount span {
    display: block;
    font: var(--font-paragraph--style) var(--font-paragraph--weight) var(--font-paragraph--size) / var(--font-paragraph--line-height) var(--font-paragraph--family);
  }

  .at-home-pro__caption,
  .at-home-tier-benefits__note,
  .at-home-tier-benefits dt {
    font-size: var(--font-size--sm);
    line-height: var(--line-height--body-normal);
  }

  .at-home-tier-benefits {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--at-home-gap);
    height: 100%;
    min-width: 0;
  }

  .at-home-tier-benefits :is(dl, dd) { margin: 0; }
  .at-home-tier-benefits__cash dd { overflow-wrap: anywhere; }
  .at-home-tier-benefits__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 92px), 1fr));
    gap: var(--at-home-gap);
    padding-block-start: var(--padding-sm);
    border-block-start: var(--style-border-width) solid rgb(var(--at-home-cream-rgb) / var(--opacity-30));
  }

  .at-home-tier-benefits__metrics > div { display: grid; align-content: space-between; }
  .at-home-tier-benefits__cta { width: 100%; }
{% endstyle %}

{% schema %}
{
  "name": "t:names.at_home_features",
  "tag": "section",
  "class": "at-guest-home-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "product_list", "id": "bulk_starter_products", "label": "t:settings.at_home_bulk_starter_products", "limit": 3 },
    { "type": "product_list", "id": "preview_recent_products", "label": "t:settings.at_member_home_preview_products", "limit": 3 }
  ]
}
{% endschema %}
