{%- capture home_tier -%}{% render 'at-member-tier' %}{%- endcapture -%}
{%- assign home_tier = home_tier | strip -%}
{%- comment -%}
  Guests get the guest promo row. Every signed-in tier (Member, Pro, Wholesale) gets the same
  member row; the second tile is "Save More with Pro" for Members and the tier welcome for Pro
  and Wholesale.
{%- endcomment -%}
{%- if home_tier != blank -%}
  <div class="section-background at-guest-home__background"></div>
  <div class="section section--page-width at-guest-home">
    <div class="at-guest-home__intro">
      {% content_for 'block', type: 'text', id: 'heading' %}
      {% content_for 'block', type: 'text', id: 'intro' %}
    </div>
    <div class="at-guest-home__grid">
      <div class="at-guest-home__seasonal">
        {% content_for 'block', type: 'group', id: 'seasonal' %}
      </div>
      {%- if home_tier != 'guest' -%}
        <div class="at-guest-home__membership at-member-home__upgrade">
          {%- if home_tier == 'member' -%}
            {% content_for 'block', type: 'group', id: 'pro' %}
          {%- else -%}
            {% content_for 'block', type: 'group', id: 'tier_welcome' %}
          {%- endif -%}
        </div>
        {%- comment -%}
          Recently viewed starts hidden and the script shows it once it has products, so a new
          member never sees an empty tile; the Bulk order tile takes its space. Always shown in
          the theme editor.
        {%- endcomment -%}
        {%- assign recent_sample = false -%}
        {%- if request.design_mode and section.settings.preview_recent_products != blank -%}
          {%- assign recent_sample = true -%}
        {%- endif -%}
        <div class="at-guest-home__tees at-member-home__tile" data-recent-tile{% unless request.design_mode %} hidden{% endunless %}>
          <h2 class="h5">{{ 'at_member_home.recent.heading' | t }}</h2>
          <at-home-recently-viewed data-search-url="{{ routes.search_url }}">
            <ul role="list" data-recent-items{% unless recent_sample %} hidden{% endunless %}>
              {%- if recent_sample -%}
                {%- for preview_product in section.settings.preview_recent_products -%}
                  <li>
                    <a class="at-member-home__viewed-link" href="{{ preview_product.url }}">
                      {%- if preview_product.featured_image -%}
                        {{ preview_product.featured_image | image_url: width: 72 | image_tag: width: 36, height: 36, alt: '', loading: 'lazy' }}
                      {%- endif -%}
                      {{ preview_product.title | escape }}
                    </a>
                  </li>
                {%- endfor -%}
              {%- endif -%}
            </ul>
            <p data-recent-empty{% if recent_sample %} data-recent-sample{% endif %}>
              {%- if recent_sample -%}{{ 'at_member_home.sample' | t }}{%- else -%}{{ 'at_member_home.recent.empty' | t }}{%- endif -%}
            </p>
          </at-home-recently-viewed>
          <script src="{{ 'at-home-recently-viewed.js' | asset_url }}" type="module" fetchpriority="low"></script>
        </div>
        <div class="at-guest-home__fleece at-member-home__tile at-member-home__bulk">
          <h2 class="h5">{{ 'at_member_home.bulk.heading' | t }}</h2>
          <p>{{ 'at_member_home.bulk.description' | t }}</p>
          {%- assign bulk_order_url = pages['bulk-order'].url -%}
          {%- if bulk_order_url != blank -%}
            <div class="at-member-home__bulk-links">
              <a href="{{ bulk_order_url }}?tab=favorite">{{ 'at_member_home.bulk.favorites' | t }} <span aria-hidden="true">→</span></a>
              <a href="{{ bulk_order_url }}?tab=purchase">{{ 'at_member_home.bulk.purchases' | t }} <span aria-hidden="true">→</span></a>
            </div>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="at-guest-home__membership">
          {% content_for 'block', type: 'group', id: 'membership' %}
        </div>
        <div class="at-guest-home__category at-guest-home__tees">
          {% content_for 'block', type: 'group', id: 'tees' %}
        </div>
        <div class="at-guest-home__category at-guest-home__fleece">
          {% content_for 'block', type: 'group', id: 'fleece' %}
        </div>
      {%- endif -%}
    </div>
  </div>

{% style %}
  .at-guest-home__background,
  main:has(.at-guest-home) { background: #fcf0e5; }

  .at-guest-home {
    --at-guest-ink: #103823;
    --at-guest-gap: 10px;
    --at-guest-radius: var(--style-border-radius-popover, 12px);
    padding-block: 16px 12px;
  }

  .at-guest-home__intro {
    display: grid;
    gap: 4px;
    margin-block-end: 12px;
  }

  .at-guest-home__intro :is(h1, h2),
  .at-guest-home__seasonal :is(h2, p),
  .at-guest-home__category h2 {
    color: var(--at-guest-ink);
  }

  .at-guest-home__grid {
    display: grid;
    gap: var(--at-guest-gap);
    grid-template-areas: "seasonal seasonal" "membership membership" "tees fleece";
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .at-guest-home__seasonal { grid-area: seasonal; min-height: clamp(270px, 35vw, 440px); }
  .at-guest-home__membership { grid-area: membership; }
  .at-guest-home__tees { grid-area: tees; }
  .at-guest-home__fleece { grid-area: fleece; }
  .at-guest-home__grid [data-recent-tile][hidden] { display: none; }
  .at-guest-home__grid:has([data-recent-tile][hidden]) {
    grid-template-areas: "seasonal seasonal" "membership membership" "fleece fleece";
  }

  .at-guest-home__grid > div > .group-block {
    height: 100%;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--at-guest-radius);
  }

  .at-guest-home__seasonal > .group-block { background-color: #efd4bb; }
  .at-guest-home__seasonal > .group-block > .group-block-content { height: 100%; }
  .at-guest-home__seasonal > .group-block > .group-block-content > .button-custom { margin-block-start: auto; }
  .at-guest-home__seasonal h2 { max-width: 10ch; font-size: clamp(2rem, 3.4vw, 3.5rem); }
  .at-guest-home__seasonal .button-custom,
  .at-guest-home__membership .button-custom { border-radius: 8px; min-height: 42px; text-transform: none; font-weight: 700; }
  .at-guest-home__seasonal p { letter-spacing: 0.12em; font-weight: 700; }
  .at-guest-home__membership h2 { font-size: clamp(1.85rem, 3.1vw, 3.1rem); }
  .at-guest-home__membership .icon-block__media { flex-shrink: 0; }
  .at-guest-home__membership .group-block-content > .group-block { min-width: 0; }
  .at-guest-home__membership :is(h2, p, p a) { color: #fff0d7; }
  .at-guest-home__membership .group-block-content p { margin-block: 0; }
  .at-guest-home__membership .group-block-content > .group-block .text-block { min-width: 0; }
  .at-guest-home__category > .group-block { background: #efdbc7; }
  .at-guest-home__category h2 { font-size: clamp(1rem, 1.8vw, 1.65rem); }
  .at-guest-home__category .button-link { font-size: clamp(.85rem, 1.1vw, 1rem); }
  .at-guest-home__fleece > .group-block { background-color: #e5e4d2; }
  .at-guest-home__category .background-image-container { inset: 0; }
  .at-guest-home__category > .group-block > .group-block-content { height: 100%; }
  .at-guest-home__category .group-block__media-wrapper { mix-blend-mode: multiply; }
  .at-guest-home__category .group-block__media-wrapper img {
    object-fit: contain;
    object-position: center;
    padding-block: 26px 18px;
  }

  .at-guest-home__category .button-unstyled {
    margin-block-start: auto;
    color: var(--at-guest-ink);
  }

  @media screen and (min-width: 750px) {
    .at-guest-home__grid {
      grid-template-areas: "seasonal membership tees" "seasonal membership fleece";
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr) minmax(0, .87fr);
      grid-template-rows: repeat(2, minmax(0, 1fr));
    }
    .at-guest-home__grid:has([data-recent-tile][hidden]) {
      grid-template-areas: "seasonal membership fleece" "seasonal membership fleece";
    }
  }

  @media screen and (max-width: 749px) {
    .at-guest-home__category { min-height: 150px; }
    .at-guest-home__seasonal h2 { font-size: 2rem; }
  }

  [id$="__at_guest_featured"] :is(.resource-list__item, .product-card, .product-card__content) {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  [id$="__at_guest_featured"] .image-block {
    position: relative;
    display: block;
    width: 100%;
    height: clamp(118px, 13vw, 210px);
    min-height: 0;
    flex: none;
    overflow: hidden;
    background-color: #efdbc7;
  }

  [id$="__at_guest_featured"] .image-block__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .at-make-tiles-section .at-tiles__label::after { content: "→" / ""; }

  .at-member-home__tile {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(12px, 1.6vw, 22px);
    background: #efdbc7;
    border-radius: var(--at-guest-radius);
  }

  .at-member-home__tile :is(h2, p) { margin: 0; }
  .at-member-home__tile h2 { color: var(--at-guest-ink); }
  .at-member-home__tile p { font-size: .875rem; }
  .at-member-home__bulk { background: #e5e4d2; }
  .at-member-home__bulk-links { display: grid; gap: 5px; margin-block-start: auto; }
  .at-member-home__bulk-links a { color: var(--at-guest-ink); font-weight: 600; }
  .at-member-home__upgrade .at-home-pro { display: grid; gap: 12px; }
  .at-member-home__upgrade .at-home-pro__amount { font-size: clamp(1.8rem, 3.4vw, 2.9rem); line-height: 1; font-weight: 700; }
  .at-member-home__upgrade .at-home-pro__amount span { display: block; font-size: 1rem; font-weight: 600; margin-block-start: 5px; }
  .at-member-home__upgrade .at-home-pro__cta { border-radius: 8px; background: #fff0d7; color: #103823; border-color: #fff0d7; text-transform: none; }
  .at-member-home__upgrade .at-home-pro__caption { font-size: .875rem; }

  at-home-recently-viewed { display: block; }
  at-home-recently-viewed ul { list-style: none; padding: 0; margin: 0; }
  at-home-recently-viewed ul:not([hidden]) { display: grid; gap: 7px; }
  .at-member-home__viewed-link { display: flex; align-items: center; gap: 8px; color: var(--at-guest-ink); font-size: .875rem; line-height: 1.2; }
  .at-member-home__viewed-link img { width: 36px; height: 36px; flex: 0 0 36px; object-fit: contain; border-radius: 4px; background: #fbede0; }

  @media screen and (max-width: 749px) {
    .at-member-home__tile { min-height: 150px; }
  }
{% endstyle %}
{%- endif -%}

{% schema %}
{
  "name": "t:names.at_home_features",
  "tag": "section",
  "class": "at-guest-home-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "product_list", "id": "preview_recent_products", "label": "t:settings.at_member_home_preview_products", "limit": 2 }
  ]
}
{% endschema %}
