{%- capture home_tier -%}{% render 'at-member-tier' %}{%- endcapture -%}
{%- liquid
  assign home_tier = home_tier | strip
  assign show_recently_viewed = false
  if customer or home_tier != 'guest'
    assign show_recently_viewed = true
  endif
  if request.design_mode and settings.at_member_preview_tier == 'guest'
    assign show_recently_viewed = false
  endif
-%}
<div class="section-background at-guest-home__background"></div>
<div class="section section--page-width at-guest-home">
  <div class="at-guest-home__intro">
    {% content_for 'block', type: 'text', id: 'heading' %}
    {% content_for 'block', type: 'text', id: 'intro' %}
  </div>
  <div class="at-guest-home__grid{% if home_tier != 'guest' %} at-guest-home__grid--member{% endif %}">
    {%- capture personal_styles -%}
      {%- if home_tier != 'guest' -%}
        {%- render 'at-home-bulk-thumbnails' -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- assign personal_styles = personal_styles | strip -%}
    <div class="at-member-home__bulk">
      <h2 class="h2">{{ 'at_member_home.bulk.heading' | t }}</h2>
      {%- if personal_styles != blank -%}
        <p>{{ 'at_member_home.bulk.description' | t }}</p>
        {{ personal_styles }}
      {%- else -%}
        <p>{{ 'at_member_home.bulk.starter_description' | t }}</p>
        {% render 'at-home-bulk-thumbnails', starter_only: true, starter_products: section.settings.bulk_starter_products %}
      {%- endif -%}
      <p class="at-member-home__bulk-detail">{{ 'at_member_home.bulk.detail' | t }}</p>
      {%- assign bulk_order_url = pages['bulk-order'].url -%}
      {%- if bulk_order_url != blank -%}
        <a class="{% if home_tier == 'guest' %}button{% else %}button-secondary{% endif %} button-with-icon at-member-home__bulk-cta" href="{{ bulk_order_url }}">
          {{ 'at-bulk-favorite.svg' | inline_asset_content }}
          {%- if home_tier != 'guest' -%}
            {{- 'at_member_home.bulk.cta' | t -}}
          {%- else -%}
            {{- 'at_member_home.bulk.guest_cta' | t -}}
          {%- endif -%}
        </a>
      {%- endif -%}
    </div>
    <div class="at-guest-home__membership{% if home_tier == 'member' %} at-member-home__upgrade{% endif %}">
      <span class="at-guest-home__membership-monogram" aria-hidden="true">
        {{- 'at-monogram.svg' | inline_asset_content -}}
      </span>
      {%- case home_tier -%}
        {%- when 'member' -%}
          {% content_for 'block', type: 'group', id: 'pro' %}
        {%- when 'pro', 'wholesale' -%}
          {% render 'at-home-tier-benefits', tier: home_tier %}
        {%- else -%}
          {% content_for 'block', type: 'group', id: 'membership' %}
      {%- endcase -%}
    </div>
    {%- if show_recently_viewed -%}
      <div class="at-guest-home__recent at-member-home__tile">
        <h2 class="h5">{{ 'at_member_home.recent.heading' | t }}</h2>
        <at-home-recently-viewed data-search-url="{{ routes.search_url }}">
          {%- assign recent_sample = false -%}
          {%- if request.design_mode and section.settings.preview_recent_products != blank -%}
            {%- assign recent_sample = true -%}
          {%- endif -%}
          <ul role="list" data-recent-items{% unless recent_sample %} hidden{% endunless %}>
            {%- if recent_sample -%}
              {%- for preview_product in section.settings.preview_recent_products -%}
                {%- assign preview_style = preview_product.title | strip | split: ' ' | first -%}
                <li>
                  <a class="at-member-home__viewed-link" href="{{ preview_product.url }}">
                    {%- if preview_product.featured_image -%}
                      {{
                        preview_product.featured_image
                        | image_url: width: 400
                        | image_tag: widths: '120, 240, 400', sizes: '(min-width: 750px) 13vw, 45vw', alt: ''
                      }}
                    {%- endif -%}
                    <span class="at-member-home__viewed-caption">
                      {% if preview_product.vendor != blank %}{{ preview_product.vendor | escape }} {% endif -%}
                      {{- preview_style | escape }}
                    </span>
                  </a>
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
          <p data-recent-empty{% if recent_sample %} data-recent-sample{% endif %}>
            {%- if recent_sample -%}{{ 'at_member_home.sample' | t }}{%- else -%}{{ 'at_member_home.recent.empty' | t }}{%- endif -%}
          </p>
        </at-home-recently-viewed>
        <script src="{{ 'at-home-recently-viewed.js' | asset_url }}" type="module" fetchpriority="low"></script>
      </div>
    {%- else -%}
      <div class="at-guest-home__categories">
        <div class="at-guest-home__category">
          {% content_for 'block', type: 'group', id: 'tees' %}
        </div>
        <div class="at-guest-home__category at-guest-home__fleece">
          {% content_for 'block', type: 'group', id: 'fleece' %}
        </div>
      </div>
    {%- endif -%}
    <div class="at-guest-home__seasonal">
      {% content_for 'block', type: 'group', id: 'seasonal' %}
    </div>
  </div>
</div>

{% style %}
  .at-guest-home__background,
  main:has(.at-guest-home) { background: #fcf0e5; }

  .at-guest-home {
    --at-guest-ink: #103823;
    --at-member-green: #174532;
    --at-member-cream: #fff0d7;
    --at-guest-gap: 10px;
    --at-guest-radius: var(--style-border-radius-popover, 12px);
    padding-block: 16px 12px;
  }

  .at-guest-home__intro {
    display: grid;
    gap: 4px;
    margin-block-end: 12px;
  }

  .at-guest-home__intro :is(h1, h2),
  .at-guest-home__seasonal :is(h2, p),
  .at-guest-home__category h2 {
    color: var(--at-guest-ink);
  }

  .at-guest-home__grid {
    display: grid;
    gap: var(--at-guest-gap);
    grid-template-areas: "bulk" "membership" "discovery" "seasonal";
    grid-template-columns: minmax(0, 1fr);
  }

  .at-guest-home__seasonal {
    --font-h2--size: clamp(1.25rem, 1.9vw, 1.875rem);
    grid-area: seasonal;
    min-height: 185px;
    min-width: 0;
  }
  .at-guest-home__membership {
    --button-context-focus-color: var(--at-member-cream);
    --monogram-size: clamp(40px, 4.6vw, 64px);
    --monogram-inset: clamp(18px, 1.9vw, 28px);
    position: relative;
    isolation: isolate;
    grid-area: membership;
    min-width: 0;
  }
  .at-guest-home__membership::after {
    position: absolute;
    z-index: 1;
    inset: 8px;
    border: 2px dashed rgb(239 227 200 / .85);
    border-radius: max(5px, calc(var(--at-guest-radius) - 4px));
    content: '';
    pointer-events: none;
  }
  .at-guest-home__membership > :is(.group-block, .at-home-tier-benefits) {
    padding-block-start: calc(var(--monogram-inset) + 1.21 * var(--monogram-size) + 12px);
  }
  .at-guest-home__membership-monogram {
    position: absolute;
    z-index: 1;
    inset-block-start: var(--monogram-inset);
    inset-inline-end: var(--monogram-inset);
    inline-size: var(--monogram-size);
    color: #efe3c8;
    pointer-events: none;
  }
  .at-guest-home__membership-monogram svg {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }
  .at-guest-home__recent,
  .at-guest-home__categories { grid-area: discovery; min-width: 0; }
  .at-guest-home__categories {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--at-guest-gap);
  }
  .at-guest-home__category { min-height: 145px; }

  .at-guest-home__grid > div > .group-block,
  .at-guest-home__category > .group-block {
    height: 100%;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--at-guest-radius);
  }

  .at-guest-home__seasonal > .group-block {
    padding: clamp(12px, 1.4vw, 20px);
    background-color: #efd4bb;
  }
  .at-guest-home__seasonal > .group-block > .group-block-content { height: 100%; }
  .at-guest-home__seasonal > .group-block > .group-block-content > :is(.button, .button-secondary, .button-custom) {
    margin-block-start: auto;
  }
  .at-guest-home__seasonal .group-block__media-wrapper::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(250 225 200 / .92), rgb(250 225 200 / .65) 48%, transparent 85%);
    content: '';
  }
  .at-guest-home__seasonal h2 {
    max-width: 12ch;
    margin-block: 0;
    line-height: 1.1;
  }
  .at-guest-home__seasonal p {
    margin: 0;
    font-size: .75rem;
    letter-spacing: .08em;
    font-weight: 700;
  }
  .at-guest-home__membership h2 { font-size: clamp(1.85rem, 3.1vw, 3.1rem); }
  .at-guest-home__membership .icon-block__media { flex-shrink: 0; }
  .at-guest-home__membership .group-block-content > .group-block { min-width: 0; }
  .at-guest-home__membership :is(h2, p, p a) { color: #fff0d7; }
  .at-guest-home__membership .group-block-content p { margin-block: 0; }
  .at-guest-home__membership .group-block-content > .group-block .text-block { min-width: 0; }
  .at-guest-home__category > .group-block { background: #efdbc7; }
  .at-guest-home__category h2 { font-size: clamp(1rem, 1.8vw, 1.65rem); }
  .at-guest-home__category .button-link { font-size: clamp(.85rem, 1.1vw, 1rem); }
  .at-guest-home__fleece > .group-block { background-color: #e5e4d2; }
  .at-guest-home__category .background-image-container { inset: 0; }
  .at-guest-home__category > .group-block > .group-block-content { height: 100%; }
  .at-guest-home__category .group-block__media-wrapper { mix-blend-mode: multiply; }
  .at-guest-home__category .group-block__media-wrapper img {
    object-fit: contain;
    object-position: center;
    padding-block: 26px 18px;
  }

  .at-guest-home__category .button-unstyled {
    margin-block-start: auto;
    color: var(--at-guest-ink);
  }

  @media screen and (min-width: 750px) {
    .at-guest-home__grid {
      grid-template-areas: "bulk membership discovery" "bulk membership seasonal";
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr) minmax(0, .87fr);
      grid-template-rows: max-content 1fr;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1099px) {
    .at-guest-home__categories { grid-template-columns: minmax(0, 1fr); }
    .at-guest-home__category { min-height: 120px; }
  }

  [id$="__at_guest_featured"] :is(.resource-list__item, .product-card, .product-card__content) {
    width: 100%;
    min-width: 0;
    max-width: 100%;
  }

  [id$="__at_guest_featured"] .image-block {
    position: relative;
    display: block;
    width: 100%;
    height: clamp(118px, 13vw, 210px);
    min-height: 0;
    flex: none;
    overflow: hidden;
    background-color: #efdbc7;
  }

  [id$="__at_guest_featured"] .image-block__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .at-make-tiles-section .at-tiles__label::after { content: "→" / ""; }

  .at-member-home__tile {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: clamp(12px, 1.4vw, 20px);
    background: #efdac5;
    color: #202820;
    border-radius: var(--at-guest-radius);
  }

  .at-member-home__tile :is(h2, p) { margin: 0; }
  .at-member-home__tile h2 {
    color: var(--at-guest-ink);
    font-size: clamp(1.375rem, 1.9vw, 1.875rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .at-member-home__tile p { font-size: .9375rem; line-height: 1.3; }
  .at-member-home__bulk {
    --bulk-background: #f1e7da;
    --bulk-text: var(--at-guest-ink);
    position: relative;
    isolation: isolate;
    grid-area: bulk;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(8px, 1vw, 16px);
    min-width: 0;
    min-height: clamp(270px, 35vw, 440px);
    padding: clamp(16px, 2.3vw, 36px);
    border-radius: var(--at-guest-radius);
    background: var(--bulk-background);
    color: var(--bulk-text);
  }
  .at-guest-home__grid--member .at-member-home__bulk {
    --bulk-background: var(--at-member-green);
    --button-context-focus-color: var(--at-member-cream);
    --bulk-text: var(--at-member-cream);
  }
  .at-member-home__bulk h2 {
    max-width: 15ch;
    margin: 0;
    color: inherit;
    font-size: clamp(1.875rem, 3.5vw, 3.75rem);
    font-weight: 700;
    line-height: 1.03;
    letter-spacing: -.035em;
    text-wrap: balance;
  }
  .at-member-home__bulk > p {
    margin: 0;
    color: inherit;
    font-size: clamp(.9375rem, 1.3vw, 1.1875rem);
    line-height: 1.35;
  }
  .at-member-home__bulk > .at-member-home__bulk-detail { font-size: .9375rem; }
  .at-member-home__bulk-cta { margin-block-start: auto; }
  .at-member-home__bulk-cta::after {
    position: absolute;
    inset: 0;
    border-radius: var(--at-guest-radius);
    content: '';
  }
  .at-member-home__bulk-thumbnails {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-self: stretch;
    gap: clamp(6px, .9vw, 14px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .at-member-home__bulk-thumbnails a {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 5px;
    height: 100%;
    padding: clamp(6px, .8vw, 12px);
    overflow: hidden;
    border-radius: 8px;
    background: #f6ecdd;
    color: var(--at-guest-ink);
    font-size: clamp(.75rem, 1vw, .9375rem);
    font-weight: 700;
    line-height: 1.15;
    text-align: center;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .at-member-home__bulk-thumbnails a:hover { text-decoration: underline; }
  .at-member-home__bulk-thumbnails a:focus-visible {
    outline: 2px solid var(--bulk-text);
    outline-offset: 2px;
  }
  .at-member-home__bulk-thumbnails img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: center top;
    mix-blend-mode: multiply;
    border-radius: 4px;
  }
  .at-member-home__upgrade .at-home-pro { display: grid; gap: 12px; }
  .at-member-home__upgrade .at-home-pro__amount { font-size: clamp(1.8rem, 3.4vw, 2.9rem); line-height: 1; font-weight: 700; }
  .at-member-home__upgrade .at-home-pro__amount span { display: block; font-size: 1rem; font-weight: 600; margin-block-start: 5px; }
  .at-member-home__upgrade { --button-secondary-label: var(--color-pro-button-text); }
  .at-member-home__upgrade .at-home-pro__caption { font-size: .875rem; }

  .at-home-tier-benefits {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
    height: 100%;
    min-width: 0;
    padding: 20px clamp(16px, 1.7vw, 26px);
    border-radius: var(--at-guest-radius);
    background: var(--tier-benefits-color);
    color: var(--at-member-cream);
  }
  .at-home-tier-benefits--pro {
    --tier-benefits-color: #6c2639;
    --button-secondary-label: var(--color-pro-button-text);
  }
  .at-home-tier-benefits--wholesale { --tier-benefits-color: #122f41; }
  .at-home-tier-benefits :is(p, dl, dd) { margin: 0; }
  .at-home-tier-benefits__kicker {
    font-size: .75rem;
    font-weight: 700;
    letter-spacing: .07em;
    text-transform: uppercase;
  }
  .at-guest-home__membership .at-home-tier-benefits__heading {
    margin: 0;
    font-size: clamp(1.5rem, 2.35vw, 2.375rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -.025em;
    text-wrap: balance;
  }
  .at-home-tier-benefits__cash {
    display: grid;
    gap: 4px;
    font-size: .875rem;
    line-height: 1.3;
  }
  .at-home-tier-benefits__cash dd {
    font-family: var(--font-heading--family);
    font-size: clamp(1.85rem, 3.15vw, 3rem);
    font-weight: 700;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }
  .at-home-tier-benefits__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 92px), 1fr));
    gap: 10px;
    padding-block-start: 12px;
    border-top: 1px solid rgb(239 227 200 / .35);
  }
  .at-home-tier-benefits__metrics > div {
    display: grid;
    align-content: space-between;
  }
  .at-home-tier-benefits__metrics dt { font-size: .8125rem; line-height: 1.3; }
  .at-home-tier-benefits__metrics dd { font-size: 1.125rem; font-weight: 700; }
  .at-home-tier-benefits__note { font-size: .875rem; line-height: 1.35; }

  at-home-recently-viewed { display: block; }
  at-home-recently-viewed ul { list-style: none; padding: 0; margin: 0; }
  at-home-recently-viewed ul:not([hidden]) {
    display: flex;
    justify-content: center;
    gap: 8px;
  }
  at-home-recently-viewed li {
    flex: 0 1 clamp(74px, 8vw, 112px);
    min-width: 0;
  }
  .at-member-home__viewed-link {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 4px;
    color: var(--at-guest-ink);
    font-size: .8125rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
  }
  .at-member-home__viewed-link:hover { text-decoration: underline; }
  .at-member-home__viewed-link img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .at-member-home__viewed-caption {
    grid-row: 2;
    display: -webkit-box;
    text-align: center;
    overflow: hidden;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

{% endstyle %}

{% schema %}
{
  "name": "t:names.at_home_features",
  "tag": "section",
  "class": "at-guest-home-section",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "product_list", "id": "bulk_starter_products", "label": "t:settings.at_home_bulk_starter_products", "limit": 3 },
    { "type": "product_list", "id": "preview_recent_products", "label": "t:settings.at_member_home_preview_products", "limit": 3 }
  ]
}
{% endschema %}
