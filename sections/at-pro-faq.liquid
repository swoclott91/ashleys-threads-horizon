{%- comment -%}
  Pro PDP section: FAQ. Answers accept [tokens]. Heading beside a wide accordion on desktop, so a
  short list (most answers are still pending policy) doesn't leave an empty column.
  A question marked "Answer pending policy" is hidden from shoppers and shown in the theme editor
  with a Pending badge, so unresolved policy is visible during development but never published.
{%- endcomment -%}
{%- capture tier -%}{% render 'at-member-tier' %}{%- endcapture -%}
{%- assign tier = tier | strip -%}
{%- unless tier == 'wholesale' -%}
{{ 'at-pro.css' | asset_url | stylesheet_tag }}
<div class="section section--page-width at-pro-page at-pro-section at-pro-faq">
  <div class="at-pro-faq__layout">
  <div class="at-pro-section__head at-pro-faq__head">
    <h2 class="at-pro-serif at-pro-section__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.intro != blank -%}<p class="at-pro-section__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
  </div>
  <div class="at-pro-faq__list">
    {%- for block in section.blocks -%}
      {%- if block.settings.pending and request.design_mode == false -%}{%- continue -%}{%- endif -%}
      <details class="at-pro-faq__item" {{ block.shopify_attributes }}>
        <summary>
          <span>{{ block.settings.question | escape }}</span>
          {%- if block.settings.pending -%}<span class="at-pro-draft">{{ 'at_pro.faq.pending' | t }}</span>{%- endif -%}
          <span class="at-pro-faq__icon" aria-hidden="true"></span>
        </summary>
        <div class="at-pro-faq__answer">{% render 'at-pro-tokens', text: block.settings.answer %}</div>
      </details>
    {%- endfor -%}
  </div>
  </div>
</div>
{%- endunless -%}

{% schema %}
{
  "name": "Pro: FAQ",
  "tag": "section",
  "class": "at-pro-section-wrap",
  "settings": [
    { "type": "paragraph", "content": "Tokens: [fee] [cash_rate] [ship_max] [ship_min] [free_ship] [ship_year] [cash_cover_spend] [cash_cover_cash]." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions from business owners" },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Straight answers about how Pro works." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" },
        { "type": "checkbox", "id": "pending", "label": "Answer pending policy", "default": false, "info": "Hidden from shoppers; shown with a Pending badge in the theme editor." }
      ]
    }
  ],
  "presets": [{ "name": "Pro: FAQ" }]
}
{% endschema %}
