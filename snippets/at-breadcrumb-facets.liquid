{%- doc -%}
  Narrows a garment collection by at most two approved, unambiguous native attributes.
  Retains the accumulated filters when the final link uses a verified subtype collection.
  @param {product} product - The current product
  @param {collection} root - The validated garment collection
  @param {string} root_label - The root link label
  @param {collection} destination - The validated canonical subtype or root
  @param {string} destination_label - The destination link label
  @param {string[]} facets - Reviewed native attribute keys in display order
{%- enddoc -%}
{%- liquid
  assign unique_facets = facets | uniq
  assign facet_count = 0
  assign query_string = ''
  assign ancestors = ''
  assign pending_url = root.url
  assign pending_label = root_label
  assign pending_id = root.id
  assign pending_separator = false
  assign taxonomy_prefix = 'gid://shopify/TaxonomyValue/'
-%}
{%- if facets.size <= 2 and unique_facets.size == facets.size and root_label != blank -%}
  {%- for key in facets limit: 2 -%}
    {%- if key == 'age-group' or key == 'target-gender' -%}
      {%- liquid
        assign fact = product.metafields.shopify[key]
        assign attribute = nil
        if fact.type == 'list.metaobject_reference' and fact.value.size == 1
          assign attribute = fact.value | first
        elsif fact.type == 'metaobject_reference'
          assign attribute = fact.value
        endif
        assign taxonomy = attribute.taxonomy_reference.value
        assign prefix = taxonomy | slice: 0, taxonomy_prefix.size
        assign label = attribute.label.value | strip
      -%}
      {%- if prefix == taxonomy_prefix and label != blank -%}
        {%- capture ancestors -%}
          {{ ancestors }}
          {%- render 'at-breadcrumb-facet-item', url: pending_url, label: pending_label, collection_id: pending_id, separator: pending_separator -%}
        {%- endcapture -%}
        {%- liquid
          assign parameter = 'filter.v.t.shopify.' | append: key
          assign value = taxonomy | url_encode
          assign pair = parameter | append: '=' | append: value
          if query_string != blank
            assign query_string = query_string | append: '&'
          endif
          assign query_string = query_string | append: pair
          assign url_separator = '?'
          if root.url contains '?'
            assign url_separator = '&'
          endif
          assign pending_url = root.url | append: url_separator | append: query_string
          assign pending_label = label
          assign pending_separator = true
          assign facet_count = facet_count | plus: 1
        -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if facet_count > 0 -%}
    {%- if destination.id != root.id -%}
      {%- capture ancestors -%}
        {{ ancestors }}
        {%- render 'at-breadcrumb-facet-item', url: pending_url, label: pending_label, collection_id: pending_id, separator: pending_separator -%}
      {%- endcapture -%}
      {%- liquid
        assign url_separator = '?'
        if destination.url contains '?'
          assign url_separator = '&'
        endif
        assign pending_url = destination.url | append: url_separator | append: query_string
        assign pending_label = destination_label
        assign pending_id = destination.id
      -%}
    {%- endif -%}
    <ol class="at-breadcrumbs__list" role="list">
      {{ ancestors }}
      {%- render 'at-breadcrumb-facet-item', url: pending_url, label: pending_label, collection_id: pending_id, separator: pending_separator, immediate: true -%}
    </ol>
  {%- endif -%}
{%- endif -%}
