{% doc %}
  Loads Ashley's Threads product-page sizing and palette overrides.

  @example
  {% render 'at-pdp-styles' %}
{% enddoc %}

{% style %}
  .at-pdp {
    --at-pdp-accent: {{ settings.color_palette.color5 | default: '#243e34' }};
    --at-pdp-accent-hover: {{ settings.color_palette.color7 | default: '#354c3f' }};
    --at-pdp-on-accent: {{ settings.palette_primary_button_text | default: '#fffdf8' }};
    --at-pdp-ink: {{ settings.page_text_color | default: '#2c2c2c' }};
    --at-pdp-line: {{ settings.color_palette.color3 | default: '#e7dbce' }};
    --at-pdp-gold: {{ settings.color_palette.foreground | default: '#bb987c' }};
  }
{% endstyle %}
{{ 'at-pdp.css' | asset_url | stylesheet_tag }}
