{%- doc -%}
  Replaces Pro program tokens in editor text with values from `at-pro-config`, so copy written in
  the theme editor never hardcodes the fee, rates or shipping rules.

  Tokens: [fee] [cash_rate] [ship_max] [ship_min] [free_ship] [ship_year] [cash_cover_spend]
  [cash_cover_cash]
  - ship_year: twelve full monthly shipping credits (a maximum, not an expected amount).
  - cash_cover_spend: annual eligible purchases whose Threads Cash covers the fee, rounded up to
    $100 (fee $79 at 2% → $4,000); cash_cover_cash: the Threads Cash that spend earns ($80).
  Rewards only: no token is derived from margin targets or the Pro price ratio.

  @param {string} text - Text or rich text containing tokens.
{%- enddoc -%}
{%- capture at_tk_config -%}{% render 'at-pro-config' %}{%- endcapture -%}
{%- liquid
  assign at_tk_fee = at_tk_config | split: ';fee=' | last | split: ';' | first | plus: 0
  assign at_tk_cash = at_tk_config | split: ';cash_bp=' | last | split: ';' | first | plus: 0
  assign at_tk_member_cash = at_tk_config | split: ';member_cash_bp=' | last | split: ';' | first | plus: 0
  assign at_tk_ship_max = at_tk_config | split: ';ship_max=' | last | split: ';' | first | plus: 0
  assign at_tk_ship_min = at_tk_config | split: ';ship_min=' | last | split: ';' | first | plus: 0
  assign at_tk_free_ship = at_tk_config | split: ';free_ship=' | last | split: ';' | first | plus: 0

  # Rates are basis points. Cover spend: fee × 10000 ÷ Pro rate, in cents, up to the next $100.
  assign at_tk_incr_cash = at_tk_cash | minus: at_tk_member_cash
  assign at_tk_cover_spend = 0
  assign at_tk_cover_cash = 0
  if at_tk_cash > 0
    assign at_tk_cover_spend = at_tk_fee | times: 10000 | divided_by: at_tk_cash | divided_by: 10000.0 | ceil | times: 10000
    assign at_tk_cover_cash = at_tk_cover_spend | times: at_tk_cash | divided_by: 10000
  endif

  assign at_tk_fee_m = at_tk_fee | money_without_trailing_zeros
  assign at_tk_ship_max_m = at_tk_ship_max | money_without_trailing_zeros
  assign at_tk_ship_min_m = at_tk_ship_min | money_without_trailing_zeros
  assign at_tk_free_ship_m = at_tk_free_ship | money_without_trailing_zeros
  assign at_tk_ship_year_m = at_tk_ship_max | times: 12 | money_without_trailing_zeros
  assign at_tk_cover_spend_m = at_tk_cover_spend | money_without_trailing_zeros
  assign at_tk_cover_cash_m = at_tk_cover_cash | money_without_trailing_zeros
  assign at_tk_cash_pct = at_tk_incr_cash | times: 1.0 | divided_by: 100 | round: 1 | append: '' | remove: '.0' | append: '%'

  echo text | replace: '[fee]', at_tk_fee_m | replace: '[cash_rate]', at_tk_cash_pct | replace: '[ship_max]', at_tk_ship_max_m | replace: '[ship_min]', at_tk_ship_min_m | replace: '[free_ship]', at_tk_free_ship_m | replace: '[ship_year]', at_tk_ship_year_m | replace: '[cash_cover_spend]', at_tk_cover_spend_m | replace: '[cash_cover_cash]', at_tk_cover_cash_m
-%}
