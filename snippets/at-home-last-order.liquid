{%- doc -%}
  Hero row side panel: "Your last order" with thumbnails, a style and piece count, and Review
  & reorder. Reads `customer.orders` in Liquid. Must render nothing when the latest order has
  nothing reorderable, so the hero row falls through to favorites, then staples.

  The latest order is the first of `customer.orders` (newest first; never `orders_count`,
  which is 0 for test orders). A line counts when its product and variant still exist and the
  product has a Color/Colour option, the same lines the bulk order page can show. Styles are
  distinct products; pieces are the summed quantities of those lines.

  Review & reorder opens `/pages/bulk-order?reorder=<order.id>`, which preselects the order's
  styles and opens the quantities dialog prefilled with the order's exact variants, all
  editable (assets/at-multi-style-quantities.js). Nothing is added to the cart from here.

  Also rendered (and discarded) by sections/at-home-shortcuts.liquid to learn whether this
  panel is showing.

  @param {string} section_id - Section ID, for unique element IDs
{%- enddoc -%}
{%- liquid
  assign at_lo_order = nil
  if customer
    for order in customer.orders limit: 1
      assign at_lo_order = order
    endfor
  endif

  assign at_lo_styles = 0
  assign at_lo_pieces = 0
  assign at_lo_pids = '|'
  assign at_lo_thumbs = ''
  if at_lo_order != nil
    for line_item in at_lo_order.line_items
      assign at_lo_product = line_item.product
      if at_lo_product == blank or line_item.variant == blank
        continue
      endif
      assign at_lo_has_color = false
      for option in at_lo_product.options_with_values
        assign at_lo_option = option.name | strip | downcase
        if at_lo_option == 'color' or at_lo_option == 'colour'
          assign at_lo_has_color = true
          break
        endif
      endfor
      unless at_lo_has_color
        continue
      endunless

      assign at_lo_pieces = at_lo_pieces | plus: line_item.quantity
      assign at_lo_pid = at_lo_product.id | append: ''
      assign at_lo_key = '|' | append: at_lo_pid | append: '|'
      if at_lo_pids contains at_lo_key
        continue
      endif
      assign at_lo_pids = at_lo_pids | append: at_lo_pid | append: '|'
      assign at_lo_styles = at_lo_styles | plus: 1
      if at_lo_styles <= 3
        assign at_lo_image = line_item.image | default: at_lo_product.featured_image
        capture at_lo_thumb
          echo '<li class="at-home-last-order__thumb">'
          if at_lo_image != blank
            echo at_lo_image | image_url: width: 240 | image_tag: loading: 'lazy', width: 120, height: 120, alt: at_lo_product.title, class: 'at-home-last-order__image'
          else
            echo '<span class="at-home-last-order__image at-home-last-order__image--empty" aria-hidden="true"></span>'
            assign at_lo_title = at_lo_product.title | escape
            echo '<span class="visually-hidden">' | append: at_lo_title | append: '</span>'
          endif
          echo '</li>'
        endcapture
        assign at_lo_thumbs = at_lo_thumbs | append: at_lo_thumb
      endif
    endfor
  endif
-%}
{%- if at_lo_styles > 0 -%}
  {%- liquid
    assign at_lo_root = routes.root_url | append: '/' | replace: '//', '/'
    assign at_lo_url = at_lo_root | append: 'pages/bulk-order?reorder=' | append: at_lo_order.id
    assign at_lo_heading_id = section_id | append: '-last-order-heading'
    if at_lo_styles == 1
      assign at_lo_style_label = '1 style'
    else
      assign at_lo_style_label = at_lo_styles | append: ' styles'
    endif
    if at_lo_pieces == 1
      assign at_lo_piece_label = '1 piece'
    else
      assign at_lo_piece_label = at_lo_pieces | append: ' pieces'
    endif
  -%}
  <section class="at-home-last-order" aria-labelledby="{{ at_lo_heading_id }}">
    <div class="at-home-last-order__head">
      <h2 class="at-home-last-order__heading" id="{{ at_lo_heading_id }}">Your last order</h2>
      <p class="at-home-last-order__count">{{ at_lo_style_label }} · {{ at_lo_piece_label }}</p>
      <p class="at-home-last-order__meta">
        Order {{ at_lo_order.name }} · {{ at_lo_order.created_at | date: '%b %-d, %Y' }}
      </p>
    </div>
    <ul class="at-home-last-order__thumbs" role="list">
      {{- at_lo_thumbs -}}
    </ul>
    <a class="at-home-last-order__button" href="{{ at_lo_url }}">
      Review &amp; reorder <span aria-hidden="true">&rarr;</span>
    </a>
  </section>
{%- endif -%}

{% stylesheet %}
  .at-home-last-order {
    display: flex;
    flex-direction: column;
    gap: 16px;
    height: 100%;
    padding: 22px;
    border-radius: 14px;
    background: #243e34;
    color: #fff;
  }
  .at-home-last-order__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .at-home-last-order__heading {
    margin: 0;
    color: inherit;
    font-size: 1.5rem;
    line-height: 1.15;
  }
  .at-home-last-order__count {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
  }
  .at-home-last-order__meta {
    margin: 0;
    font-size: 0.85rem;
    opacity: 0.8;
  }
  .at-home-last-order__thumbs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .at-home-last-order__thumb {
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 10px;
    background: #fff;
  }
  .at-home-last-order__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .at-home-last-order__image--empty {
    background: rgb(36 62 52 / 0.08);
  }
  .at-home-last-order__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-block-start: auto;
    min-height: 46px;
    padding: 10px 18px;
    border-radius: 999px;
    background: #fff;
    color: #243e34;
    font-weight: 700;
    text-decoration: none;
  }
  .at-home-last-order__button:hover {
    background: #f6f1e7;
  }
  .at-home-last-order__button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  @media screen and (max-width: 989px) {
    .at-home-last-order {
      padding: 18px;
    }
    .at-home-last-order__thumbs {
      max-width: 300px;
    }
  }
{% endstylesheet %}
