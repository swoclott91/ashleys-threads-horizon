{%- doc -%}
  AT Menu – Mobile Drawer (view-stack architecture)

  Renders inside the <header-drawer>'s .menu-drawer container.
  Uses <at-menu-panel> for multi-view navigation:
    – main   : categories (no Brands) + remaining main-menu links
    – brands : alphabet text directory + featured logos (SSR — no image grid)
    – cat-*  : adopted from at-menu-data on demand

  @param {object}  menu_links - Top-level links from the main nav.
  @param {string}  panel_handle - Products panel handle (inlined as categories).
  @param {object}  categories_linklist - Categories sidebar.
  @param {object}  brands_linklist - Full brands linklist.
  @param {string}  brands_handle - Top-level Brands nav handle.
  @param {object}  [featured_brands_linklist] - Featured brand logos.
  @param {string}  highlight_handle - Highlighted item handle.
  @param {string}  mobile_drawer_label - Main view heading.
  @param {object}  [block_settings] - AT Menu block settings (CTAs, radius).
{%- enddoc -%}

{%- liquid
  assign drawer_heading = mobile_drawer_label | default: 'Shop'
  assign brands_handle = brands_handle | default: 'brands'
  assign brand_source_exists = false
  if brands_linklist != blank and brands_linklist.links.size > 0
    assign brand_source_exists = true
  endif

  assign brands_nav_title = 'Brands'
  for link in menu_links
    if link.handle == brands_handle
      assign brands_nav_title = link.title
      break
    endif
  endfor

  assign img_radius = block_settings.at_brand_image_border_radius | default: 4
  assign featured_heading = block_settings.at_featured_brands_heading | default: 'Featured Brands'
  assign featured_links = featured_brands_linklist.links | default: blank
  assign show_search = true
  if block_settings.at_show_brand_search == false
    assign show_search = false
  endif

  assign cta_1_label = block_settings.at_brands_cta_1_label | default: 'Shop All Brands'
  assign cta_1_link = block_settings.at_brands_cta_1_link
  assign cta_2_label = block_settings.at_brands_cta_2_label
  assign cta_2_link = block_settings.at_brands_cta_2_link
  assign cta_3_label = block_settings.at_brands_cta_3_label
  assign cta_3_link = block_settings.at_brands_cta_3_link
-%}

<at-menu-panel class="at-panel" data-brands-mode="directory">

  <div class="at-panel__view" data-view="main">
    <div class="at-panel__header">
      <h2 class="at-panel__title">{{- drawer_heading | escape -}}</h2>
      <button
        type="button"
        class="at-panel__close"
        aria-label="{{ 'actions.close' | t | default: 'Close menu' }}"
        on:click="header-drawer/close"
      >
        <span class="svg-wrapper">{{- 'icon-close.svg' | inline_asset_content -}}</span>
      </button>
    </div>

    <nav class="at-panel__body" aria-label="{{ drawer_heading | escape }}">
      <ul class="at-panel__list" role="list">
        {%- if brand_source_exists -%}
          <li class="at-panel__list-item" style="--at-panel-index: 0;">
            <button
              type="button"
              class="at-panel__item"
              on:click="/navigate"
              data-target="brands"
            >
              <span class="at-panel__item-text">{{- brands_nav_title -}}</span>
              <span class="at-panel__chevron svg-wrapper" aria-hidden="true">
                {{- 'icon-chevron-right.svg' | inline_asset_content -}}
              </span>
            </button>
          </li>
        {%- endif -%}

        {%- if categories_linklist != blank -%}
          {%- for cat_link in categories_linklist.links -%}
            {%- if cat_link.handle == brands_handle -%}
              {%- continue -%}
            {%- endif -%}
            {%- assign is_highlight = false -%}
            {%- if cat_link.handle == highlight_handle -%}
              {%- assign is_highlight = true -%}
            {%- endif -%}
            <li class="at-panel__list-item" style="--at-panel-index: {{ forloop.index }};">
              {%- if cat_link.links != blank -%}
                <button
                  type="button"
                  class="at-panel__item{% if is_highlight %} at-panel__item--highlight{% endif %}"
                  on:click="/navigate"
                  data-target="cat-{{ cat_link.handle }}"
                >
                  <span class="at-panel__item-text">{{- cat_link.title -}}</span>
                  <span class="at-panel__chevron svg-wrapper" aria-hidden="true">
                    {{- 'icon-chevron-right.svg' | inline_asset_content -}}
                  </span>
                </button>
              {%- else -%}
                <a
                  href="{{ cat_link.url }}"
                  class="at-panel__item{% if is_highlight %} at-panel__item--highlight{% endif %}"
                  {% if cat_link.current %}aria-current="page"{% endif %}
                >
                  <span class="at-panel__item-text">{{- cat_link.title -}}</span>
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- endif -%}

        {%- for link in menu_links -%}
          {%- if link.handle == panel_handle or link.handle == brands_handle -%}
            {%- continue -%}
          {%- endif -%}
          <li class="at-panel__list-item" style="--at-panel-index: {{ forloop.index | plus: 20 }};">
            {%- if link.links != blank -%}
              <details class="at-panel__accordion">
                <summary class="at-panel__item">
                  <span class="at-panel__item-text">{{- link.title -}}</span>
                  <span class="at-panel__chevron at-panel__accordion-icon svg-wrapper" aria-hidden="true">
                    {{- 'icon-chevron-right.svg' | inline_asset_content -}}
                  </span>
                </summary>
                <ul class="at-panel__sub-list" role="list">
                  {%- for sub_link in link.links -%}
                    <li>
                      <a
                        href="{{ sub_link.url }}"
                        class="at-panel__sub-item"
                        {% if sub_link.current %}aria-current="page"{% endif %}
                      >
                        {{- sub_link.title -}}
                      </a>
                    </li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a
                href="{{ link.url }}"
                class="at-panel__item{% if link.handle == highlight_handle %} at-panel__item--highlight{% endif %}"
                {% if link.current %}aria-current="page"{% endif %}
              >
                <span class="at-panel__item-text">{{- link.title -}}</span>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  </div>

  {%- if brand_source_exists -%}
    <div class="at-panel__view at-panel__view--brands at-panel__view--brands-dir" data-view="brands" hidden>
      <div class="at-panel__header">
        <button
          type="button"
          class="at-panel__back"
          aria-label="{{ 'actions.back' | t | default: 'Back' }}"
          on:click="/back"
        >
          <span class="svg-wrapper">{{- 'icon-chevron-left.svg' | inline_asset_content -}}</span>
        </button>
        <h2 class="at-panel__title">{{- brands_nav_title | escape -}}</h2>
        <button
          type="button"
          class="at-panel__close"
          aria-label="{{ 'actions.close' | t | default: 'Close menu' }}"
          on:click="header-drawer/close"
        >
          <span class="svg-wrapper">{{- 'icon-close.svg' | inline_asset_content -}}</span>
        </button>
      </div>

      {%- if cta_1_label != blank or cta_2_label != blank or cta_3_label != blank -%}
        <div class="at-brands-dir__ctas at-brands-dir__ctas--mobile" role="group" aria-label="Brand collections">
          {%- if cta_1_label != blank and cta_1_link != blank -%}
            <a href="{{ cta_1_link }}" class="at-brands-dir__cta at-brands-dir__cta--primary">
              {{- cta_1_label -}}
              <span aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
          {%- if cta_2_label != blank and cta_2_link != blank -%}
            <a href="{{ cta_2_link }}" class="at-brands-dir__cta">{{- cta_2_label -}}</a>
          {%- endif -%}
          {%- if cta_3_label != blank and cta_3_link != blank -%}
            <a href="{{ cta_3_link }}" class="at-brands-dir__cta">{{- cta_3_label -}}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if show_search -%}
        <div class="at-panel__search-wrapper" role="search">
          <span class="at-panel__search-icon svg-wrapper" aria-hidden="true">
            {{- 'icon-search.svg' | inline_asset_content -}}
          </span>
          <label for="at-panel-brand-search" class="visually-hidden">Search brands</label>
          <input
            ref="searchInput"
            id="at-panel-brand-search"
            type="search"
            class="at-panel__search"
            placeholder="Search brands…"
            autocomplete="off"
            aria-label="Search brands"
          >
          <button
            ref="searchClear"
            type="button"
            class="at-panel__search-clear"
            aria-label="Clear search"
            hidden
          >
            <span class="svg-wrapper">{{- 'icon-close.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      {%- endif -%}

      {%- if featured_links != blank -%}
        <div class="at-brands-dir__featured at-brands-dir__featured--mobile">
          <h3 class="at-brands-dir__featured-heading">{{- featured_heading | escape -}}</h3>
          <ul class="at-brands-dir__featured-list list-unstyled" role="list">
            {%- for feat_link in featured_links limit: 6 -%}
              {%- liquid
                assign feat_image = blank
                if feat_link.type == 'collection_link' and feat_link.object.featured_image != blank
                  assign feat_image = feat_link.object.featured_image
                elsif feat_link.type == 'collection_link' and feat_link.object.image != blank
                  assign feat_image = feat_link.object.image
                endif
              -%}
              <li>
                <a
                  href="{{ feat_link.url }}"
                  class="at-brands-dir__featured-card"
                  style="--at-brand-avatar-radius: {{ img_radius }}px;"
                >
                  {%- if feat_image != blank -%}
                    {{
                      feat_image
                      | image_url: width: 240
                      | image_tag:
                        alt: feat_link.title,
                        loading: 'lazy',
                        decoding: 'async',
                        class: 'at-brands-dir__featured-img',
                        widths: '120, 180, 240',
                        sizes: '30vw'
                    }}
                  {%- else -%}
                    <span class="at-brands-dir__featured-fallback" aria-hidden="true">
                      {{- feat_link.title | slice: 0, 2 | upcase -}}
                    </span>
                  {%- endif -%}
                  <span class="at-brands-dir__featured-title">{{- feat_link.title -}}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="at-panel__body at-brands-dir__scroll" id="at-panel-brands-body" ref="brandsBody">
        {%- render 'at-menu-brands-alpha-columns',
          brands_linklist: brands_linklist,
          class_prefix: 'at-brands-dir'
        -%}
      </div>
    </div>
  {%- endif -%}

</at-menu-panel>
