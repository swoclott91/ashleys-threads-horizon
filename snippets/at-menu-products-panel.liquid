{%- doc -%}
  Products mega-panel: category sidebar (icons) + columns/thumbs + featured rail.

  Structure from `categories_linklist` (3-level preferred).
  Chrome (icon + featured) from nested `_at-menu-category` blocks on the AT Menu,
  matched by `category_handle`.

  Full body is SSR'd. Inactive category thumbs use data-at-thumb-src until first open.

  @param {object} panel_link - Top-level Products nav link.
  @param {object} categories_linklist - Categories menu.
  @param {string} [brands_handle] - Handle to skip if still present in categories.
  @param {object} section - AT Menu block (settings + nested blocks).
{%- enddoc -%}

{%- liquid
  assign brands_handle = brands_handle | default: 'brands'
  assign panel_id = 'at-products-panel-' | append: panel_link.handle
  assign menu_block = section

  assign first_cat_handle = blank
  for cat_link in categories_linklist.links
    if cat_link.handle == brands_handle
      continue
    endif
    assign first_cat_handle = cat_link.handle
    break
  endfor
-%}

<at-brands-panel
  class="at-brands-panel at-brands-panel--products"
  data-mode="products"
  on:pointerenter="/open"
>
  <button
    ref="trigger"
    class="menu-list__link at-menu__nav-link"
    aria-expanded="false"
    aria-controls="{{ panel_id }}"
    aria-haspopup="true"
    on:click="/open"
  >
    <span class="menu-list__link-title">{{- panel_link.title -}}</span>
  </button>

  <div
    id="{{ panel_id }}"
    ref="panel"
    class="at-brands-panel__dropdown at-products-panel"
    hidden
  >
    <div class="at-brands-panel__sidebar at-products-panel__sidebar" role="navigation" aria-label="Product categories">
      <ul class="list-unstyled" role="list">
        {%- for cat_link in categories_linklist.links -%}
          {%- if cat_link.handle == brands_handle -%}
            {%- continue -%}
          {%- endif -%}
          {%- liquid
            assign is_active = false
            if cat_link.handle == first_cat_handle
              assign is_active = true
            endif

            assign cat_icon = 'shirt'
            if menu_block.blocks != blank
              for chrome in menu_block.blocks
                if chrome.type == '_at-menu-category' and chrome.settings.category_handle == cat_link.handle
                  if chrome.settings.icon != blank
                    assign cat_icon = chrome.settings.icon
                  endif
                  break
                endif
              endfor
            endif
          -%}
          <li>
            <button
              class="at-brands-panel__cat-btn at-products-panel__cat-btn{% if is_active %} at-brands-panel__cat-btn--active{% endif %}"
              data-cat="{{ cat_link.handle }}"
              on:click="/switchCategory"
              aria-pressed="{{ is_active }}"
              type="button"
            >
              <span class="at-products-panel__cat-icon" aria-hidden="true">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  width="20"
                  height="20"
                  focusable="false"
                >
                  {%- render 'icon', icon: cat_icon -%}
                </svg>
              </span>
              <span class="at-products-panel__cat-label">{{- cat_link.title -}}</span>
              <span class="at-brands-panel__cat-chevron svg-wrapper" aria-hidden="true">
                {{- 'icon-chevron-right.svg' | inline_asset_content -}}
              </span>
            </button>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="at-brands-panel__content at-products-panel__content">
      {%- for cat_link in categories_linklist.links -%}
        {%- if cat_link.handle == brands_handle -%}
          {%- continue -%}
        {%- endif -%}
        {%- liquid
          assign is_active = false
          if cat_link.handle == first_cat_handle
            assign is_active = true
          endif

          assign featured_image = blank
          assign featured_collection = blank
          assign featured_eyebrow = 'Featured Collection'
          assign featured_title = 'Best Sellers'
          assign featured_cta_label = 'Shop'

          if menu_block.blocks != blank
            for chrome in menu_block.blocks
              if chrome.type == '_at-menu-category' and chrome.settings.category_handle == cat_link.handle
                assign featured_image = chrome.settings.featured_image
                assign featured_collection = chrome.settings.featured_collection
                if chrome.settings.featured_eyebrow != blank
                  assign featured_eyebrow = chrome.settings.featured_eyebrow
                endif
                if chrome.settings.featured_title != blank
                  assign featured_title = chrome.settings.featured_title
                endif
                if chrome.settings.featured_cta_label != blank
                  assign featured_cta_label = chrome.settings.featured_cta_label
                endif
                break
              endif
            endfor
          endif
        -%}

        <div
          class="at-brands-panel__cat-content at-products-panel__cat-content"
          data-cat="{{ cat_link.handle }}"
          {% unless is_active %}hidden{% endunless %}
        >
          {%- render 'at-menu-products-category-body',
            cat_link: cat_link,
            is_active: is_active,
            featured_image: featured_image,
            featured_collection: featured_collection,
            featured_eyebrow: featured_eyebrow,
            featured_title: featured_title,
            featured_cta_label: featured_cta_label,
            class_prefix: 'at-products'
          -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</at-brands-panel>
