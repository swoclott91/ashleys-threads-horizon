{%- doc -%}
  Ashley's Pro savings calculator: the one calculator on the Pro PDP (docs/pro-membership-pdp.md).
  Value first: the estimated net annual savings, a short breakdown and the break-even conclusion,
  then the spend slider, then restocks and shipping behind "Adjust spending and shipping
  assumptions". Math is assets/at-pro-value.js; values come from `at-pro-config`.

  Every input is a hypothetical. It never shows or overwrites a customer's historical figures
  (states C and D show those above it, and open this calculator as "Estimate your next 12 months").

  @param {string} id - Unique id prefix for the fields.
  @param {number} monthly - Prefilled monthly Member-price spend, in dollars.
  @param {number} [restocks] - Prefilled restocks a month (default 3).
  @param {number} [ship] - Prefilled shipping charge per restock, in dollars (default 12).
  @param {boolean} [personal] - The prefill came from the customer's own orders.
  @param {number} [max_monthly] - Slider maximum, in dollars (default 3000).
{%- enddoc -%}
{%- capture at_calc_config -%}{% render 'at-pro-config' %}{%- endcapture -%}
{%- liquid
  assign at_calc_restocks = restocks | default: 3
  assign at_calc_ship = ship | default: 12
  assign at_calc_max = max_monthly | default: 3000
  if monthly > at_calc_max
    assign at_calc_max = monthly
  endif

  assign at_calc_fee = at_calc_config | split: ';fee=' | last | split: ';' | first | plus: 0
  assign at_calc_ratio = at_calc_config | split: ';ratio_bp=' | last | split: ';' | first | times: 1.0 | divided_by: 10000
  assign at_calc_cash = at_calc_config | split: ';cash_bp=' | last | split: ';' | first | times: 1.0 | divided_by: 10000
  assign at_calc_member_cash = at_calc_config | split: ';member_cash_bp=' | last | split: ';' | first | times: 1.0 | divided_by: 10000
  assign at_calc_ship_max = at_calc_config | split: ';ship_max=' | last | split: ';' | first | plus: 0
  assign at_calc_ship_min = at_calc_config | split: ';ship_min=' | last | split: ';' | first | plus: 0
  assign at_calc_free_ship = at_calc_config | split: ';free_ship=' | last | split: ';' | first | plus: 0

  assign at_calc_fee_money = at_calc_fee | money_without_trailing_zeros
  assign at_calc_ship_max_money = at_calc_ship_max | money_without_trailing_zeros
  assign at_calc_ship_min_money = at_calc_ship_min | money_without_trailing_zeros
  assign at_calc_free_ship_money = at_calc_free_ship | money_without_trailing_zeros
  assign at_calc_cash_pct = at_calc_cash | minus: at_calc_member_cash | times: 100 | round: 1 | append: '' | remove: '.0' | append: '%'
  assign at_calc_symbol = cart.currency.symbol | default: '$'
-%}
<at-pro-calculator
  class="at-pro-calc"
  data-currency="{{ shop.currency }}"
  data-default-restocks="{{ at_calc_restocks }}"
  data-default-ship="{{ at_calc_ship }}"
  data-config='{"fee":{{ at_calc_fee }},"ratio":{{ at_calc_ratio }},"cashRate":{{ at_calc_cash }},"memberCashRate":{{ at_calc_member_cash }},"shipMax":{{ at_calc_ship_max }},"shipMin":{{ at_calc_ship_min }},"freeShip":{{ at_calc_free_ship }}}'
>
  <div class="at-pro-calc__results" aria-live="polite">
    <p class="at-pro-figure-block">
      <span class="at-pro-figure-block__label" data-pro-show="net-positive" hidden>{{ 'at_pro.calculator.net_label' | t }}</span>
      <span class="at-pro-figure-block__label" data-pro-show="net-negative" hidden>{{ 'at_pro.calculator.total_label' | t }}</span>
      <span class="at-pro-figure at-pro-figure--hero" data-pro-show="net-positive" data-pro-out="net" hidden></span>
      <span class="at-pro-figure at-pro-figure--hero" data-pro-show="net-negative" data-pro-out="total" hidden></span>
      <span class="at-pro-figure-block__caption" data-pro-show="net-positive" hidden>{{ 'at_pro.calculator.net_caption' | t }}</span>
      <span class="at-pro-figure-block__caption" data-pro-show="net-negative" hidden>{{ 'at_pro.calculator.total_caption' | t }}</span>
    </p>

    <dl class="at-pro-breakdown">
      <div class="at-pro-breakdown__row at-pro-breakdown__row--primary">
        <dt>{{ 'at_pro.value.pricing' | t }}</dt>
        <dd data-pro-out="pricing"></dd>
      </div>
      <div class="at-pro-breakdown__row">
        <dt>{{ 'at_pro.value.cash' | t: rate: at_calc_cash_pct }}</dt>
        <dd data-pro-out="cash"></dd>
      </div>
      <div class="at-pro-breakdown__row">
        <dt>{{ 'at_pro.value.shipping' | t }}</dt>
        <dd data-pro-out="shipping"></dd>
      </div>
      <div class="at-pro-breakdown__row at-pro-breakdown__row--fee">
        <dt>{{ 'at_pro.value.fee' | t }}</dt>
        <dd data-pro-out="fee"></dd>
      </div>
    </dl>

    <div class="at-pro-progress" role="presentation" data-pro-show="net-negative" hidden>
      <span class="at-pro-progress__bar"></span>
    </div>
    <p class="at-pro-conclusion">
      <span class="at-pro-conclusion__success" data-pro-show="net-positive" hidden>
        <span data-pro-out="payback-text" data-one="{{ 'at_pro.calculator.payback.one' | t | escape }}" data-other="{{ 'at_pro.calculator.payback.other' | t | escape }}"></span>
      </span>
      <span data-pro-show="net-negative" hidden>
        {{ 'at_pro.calculator.breakeven_prefix' | t }} <strong data-pro-out="breakeven"></strong>{{ 'at_pro.calculator.breakeven_suffix' | t }}
      </span>
    </p>
  </div>

  <div class="at-pro-calc__inputs">
    <div class="at-pro-calc__field">
      <div class="at-pro-calc__field-head">
        <label for="{{ id }}-monthly">{{ 'at_pro.calculator.monthly_label' | t }}</label>
        <span class="at-pro-calc__money-input">
          <span aria-hidden="true">{{ at_calc_symbol }}</span>
          <input
            type="number"
            id="{{ id }}-monthly"
            inputmode="numeric"
            min="0"
            step="1"
            value="{{ monthly }}"
            data-pro-input="monthly"
          >
        </span>
      </div>
      <input
        type="range"
        class="at-pro-calc__range"
        id="{{ id }}-monthly-range"
        min="0"
        max="{{ at_calc_max }}"
        step="25"
        value="{{ monthly }}"
        aria-label="{{ 'at_pro.calculator.monthly_label' | t }}"
        data-pro-mirror="monthly"
      >
      <p class="at-pro-calc__help">
        {%- if personal -%}
          {{ 'at_pro.calculator.monthly_help_personal' | t }}
        {%- else -%}
          {{ 'at_pro.calculator.monthly_help' | t }}
        {%- endif -%}
      </p>
    </div>

    <details class="at-pro-calc__advanced">
      <summary>
        <span>{{ 'at_pro.calculator.adjust' | t }}</span>
        {%- assign at_calc_ship_money = at_calc_ship | times: 100 | money_without_trailing_zeros -%}
        <span
          class="at-pro-calc__assumption"
          data-pro-echo="assumption"
          data-one="{{ 'at_pro.calculator.assumption.one' | t | escape }}"
          data-other="{{ 'at_pro.calculator.assumption.other' | t | escape }}"
        >
          {%- if at_calc_restocks == 1 -%}
            {{- 'at_pro.calculator.assumption.one' | t | replace: '[ship]', at_calc_ship_money -}}
          {%- else -%}
            {{- 'at_pro.calculator.assumption.other' | t | replace: '[count]', at_calc_restocks | replace: '[ship]', at_calc_ship_money -}}
          {%- endif -%}
        </span>
      </summary>
      <div class="at-pro-calc__advanced-body">
        <div class="at-pro-calc__field">
          <label for="{{ id }}-restocks">{{ 'at_pro.calculator.restocks_label' | t }}</label>
          <select id="{{ id }}-restocks" data-pro-input="restocks">
            {%- for n in (0..8) -%}
              <option value="{{ n }}"{% if n == at_calc_restocks %} selected{% endif %}>{{ n }}</option>
            {%- endfor -%}
          </select>
        </div>
        <div class="at-pro-calc__field">
          <label for="{{ id }}-ship">{{ 'at_pro.calculator.ship_label' | t }}</label>
          <span class="at-pro-calc__money-input">
            <span aria-hidden="true">{{ at_calc_symbol }}</span>
            <input type="number" id="{{ id }}-ship" inputmode="decimal" min="0" step="1" value="{{ at_calc_ship }}" data-pro-input="ship">
          </span>
        </div>
        <p class="at-pro-calc__help at-pro-calc__advanced-help">
          {{ 'at_pro.calculator.ship_rules' | t: max: at_calc_ship_max_money, min: at_calc_ship_min_money, free: at_calc_free_ship_money }}
        </p>
        <p class="at-pro-calc__help" data-pro-show="ship-ineligible" hidden>
          {{ 'at_pro.calculator.ship_ineligible' | t: min: at_calc_ship_min_money, free: at_calc_free_ship_money }}
        </p>
      </div>
    </details>
  </div>

  <p class="at-pro-calc__disclaimer">{{ 'at_pro.calculator.disclaimer' | t: fee: at_calc_fee_money }}</p>
</at-pro-calculator>
