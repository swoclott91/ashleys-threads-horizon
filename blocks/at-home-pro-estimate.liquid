{%- liquid
  assign savings = customer.metafields.wagner.savings_ytd.value
  assign amount = savings.pro_would_save | default: 0 | times: 100 | round
  assign fee = shop.metafields.wagner.tier_thresholds.value.pro.fee | default: 0 | times: 100 | round
  assign currency = savings.currency_code | default: shop.currency
  assign show_numbers = false
  assign sample = false
  if currency == localization.country.currency.iso_code and currency == shop.currency
    assign show_numbers = true
  endif
  if request.design_mode and settings.at_member_preview_tier == 'member' and savings == blank
    assign amount = 14000
    assign fee = 7900
    assign sample = true
    assign show_numbers = true
  endif

  assign pro_url = block.settings.pro_url
  if pro_url == blank
    assign pro_url = pages.membership.url
  endif
-%}
<div class="at-home-pro" {{ block.shopify_attributes }}>
  {%- if sample -%}
    <p class="at-home-pro__caption">{{ 'at_member_home.sample' | t }}</p>
  {%- endif -%}
  {%- if show_numbers and amount > 0 -%}
    <p class="at-home-pro__amount">
      {{ amount | money_with_currency }}
      <span>{{ 'at_member_home.pro.could_save' | t }}</span>
    </p>
    <p class="at-home-pro__caption">{{ 'at_member_home.pro.basis' | t }}</p>
  {%- else -%}
    <p>{{ 'at_member_home.pro.empty' | t }}</p>
  {%- endif -%}

  {%- if show_numbers and fee > 0 -%}
    {%- assign fee_display = fee | money_with_currency -%}
    <p class="at-home-pro__caption">{{ 'at_member_home.pro.annual_fee' | t: fee: fee_display }}</p>
  {%- endif -%}

  {%- if pro_url != blank -%}
    <a class="button at-home-pro__cta" href="{{ pro_url }}">{{ 'at_member_home.pro.cta' | t }}</a>
  {%- else -%}
    <a class="button at-home-pro__cta" href="{{ routes.account_url }}">{{ 'at_member_home.pro.account' | t }}</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:names.at_home_pro_estimate",
  "tag": null,
  "settings": [
    { "type": "url", "id": "pro_url", "label": "t:settings.at_home_pro_url" }
  ],
  "presets": [{ "name": "t:names.at_home_pro_estimate" }]
}
{% endschema %}
