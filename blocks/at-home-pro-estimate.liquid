{%- comment -%}
  Pro savings estimate for Members (member-homepage-data-handoff, "Pro savings").
  - Amount: customer `wagner.savings_ytd.pro_would_save`, the gross saving before the fee for
    the calendar year so far. Currency comes from `savings_ytd.currency` (not `currency_code`).
  - Fee: shop `wagner.tier_thresholds.pro.fee`, falling back to 79.00.
  - The number is hidden (general Pro message instead) when the amount is zero or missing, when
    the currency doesn't match the store and storefront currency, or when the figure is for an
    earlier calendar year (it resets on January 1 until the next order).
  - Theme editor: a labelled sample amount, never shopper data.
{%- endcomment -%}
{%- liquid
  assign savings = customer.metafields.wagner.savings_ytd.value
  assign amount = savings.pro_would_save | default: 0 | times: 100 | round
  assign fee = shop.metafields.wagner.tier_thresholds.value.pro.fee | default: '79.00' | times: 100 | round
  assign currency = savings.currency | default: '' | upcase
  assign this_year = 'now' | date: '%Y' | plus: 0
  assign savings_year = savings.year | default: this_year | plus: 0
  assign sample = false

  assign show_numbers = false
  if amount > 0 and currency == shop.currency and localization.country.currency.iso_code == shop.currency and savings_year == this_year
    assign show_numbers = true
  endif

  if request.design_mode
    assign amount = 14000
    assign sample = true
    assign show_numbers = true
  endif

  # Until the Pro signup or details link is set, the call to action opens the account.
  assign pro_url = block.settings.pro_url
-%}
<div class="at-home-pro" {{ block.shopify_attributes }}>
  {%- if sample -%}
    <p class="at-home-pro__caption">{{ 'at_member_home.sample' | t }}</p>
  {%- endif -%}
  {%- if show_numbers and amount > 0 -%}
    <p class="at-home-pro__amount">
      {{ amount | money_with_currency }}
      <span>{{ 'at_member_home.pro.could_save' | t }}</span>
    </p>
    <p class="at-home-pro__caption">{{ 'at_member_home.pro.basis' | t }}</p>
  {%- else -%}
    <p>{{ 'at_member_home.pro.empty' | t }}</p>
  {%- endif -%}

  {%- if show_numbers and fee > 0 -%}
    {%- assign fee_display = fee | money_with_currency -%}
    <p class="at-home-pro__caption">{{ 'at_member_home.pro.annual_fee' | t: fee: fee_display }}</p>
  {%- endif -%}

  {%- if pro_url != blank -%}
    <a class="button-secondary" href="{{ pro_url }}">{{ 'at_member_home.pro.cta' | t }}</a>
  {%- else -%}
    <a class="button-secondary" href="{{ routes.account_url }}">{{ 'at_member_home.pro.account' | t }}</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:names.at_home_pro_estimate",
  "tag": null,
  "settings": [
    { "type": "url", "id": "pro_url", "label": "t:settings.at_home_pro_url" }
  ],
  "presets": [{ "name": "t:names.at_home_pro_estimate" }]
}
{% endschema %}
