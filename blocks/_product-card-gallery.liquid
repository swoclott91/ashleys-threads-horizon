{% assign product = closest.product %}

{%- capture product_badge -%}
  {%- render 'product-card-badge', product: product, featured_label: block.settings.featured_badge_label -%}
{%- endcapture -%}

{% capture children %}
  {% unless product == blank %}
    {{ product_badge }}
    {% if product.available and settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add', product: product, section_id: section.id %}
    {% endif %}
  {% endunless %}
{% endcapture %}

{%- liquid
  assign play_video = false
  if block.settings.play_first_video and product.featured_media.media_type == 'video'
    assign play_video = true
    case block.settings.image_ratio
      when 'square'
        assign video_ratio = '1'
      when 'landscape'
        assign video_ratio = '16 / 9'
      when 'portrait'
        assign video_ratio = '4 / 5'
      else
        assign video_ratio = product.featured_media.aspect_ratio | default: '0.8'
    endcase
  endif
-%}

{%- if play_video -%}
  {% # Muted looping clip in place of the image gallery; the card's own link overlay keeps it clickable. %}
  <div
    class="card-gallery at-card-gallery--video spacing-style border-style{% if product_badge != blank %} card-gallery--badge-{{ settings.badge_position }}{% endif %}"
    style="--at-card-video-ratio: {{ video_ratio }}; {% render 'spacing-style', settings: block.settings %} {% render 'border-override', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {% render 'at-card-video', media: product.featured_media, alt: product.title %}
    {{ children }}
  </div>
{%- else -%}
  {% render 'card-gallery', children: children, product_badge: product_badge %}
{%- endif -%}

{% # Title for the zoomed out grid view %}
<h3 class="product-grid-view-zoom-out--details">
  {%- if product == blank -%}
    {{- 'content.product_card_placeholder' | t -}}
  {%- else -%}
    {{- product.title -}}
  {%- endif -%}
</h3>

{% render 'product-card-gallery-zoom-details-styles' %}
{% render 'product-badges-styles' %}

{% schema %}
{
  "name": "t:names.product_image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_media"
    },
    {
      "type": "checkbox",
      "id": "play_first_video",
      "label": "Play first video",
      "info": "When the product's first media is a video, show it as a muted loop that plays while on screen. Use on a few hand-picked cards, not whole grids.",
      "default": false
    },
    {
      "type": "text",
      "id": "featured_badge_label",
      "label": "Featured badge",
      "info": "Shown over the media in place of the Sale badge, for example Ashley’s Choice. Sold out still takes priority."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "portrait",
      "label": "t:settings.aspect_ratio",
      "info": "t:info.aspect_ratio_adjusted"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.product_card_media",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
