{% assign icons = 'price_tag,cotton_ring_spun,ruler,shirt' | split: ',' %}

<nav class="at-guide-navigation" aria-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>
  <ul class="list-unstyled at-guide-navigation__links">
    {% for icon in icons %}
      {% liquid
        assign label_key = 'label_' | append: forloop.index
        assign link_key = 'link_' | append: forloop.index
        assign label = block.settings[label_key]
        assign link = block.settings[link_key]
      %}
      {% if label != blank and link != blank %}
        <li>
          <a href="{{ link | escape }}">
            {% render 'icon-or-image', icon: icon, width: 18, class_name: 'at-guide-navigation__icon' %}
            <span>{{ label | escape }}</span>
          </a>
        </li>
      {% endif %}
    {% endfor %}
  </ul>
</nav>

{% stylesheet %}
  .at-guide-navigation__links {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--gap-md);
    margin: 0;
  }

  .at-guide-navigation a {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs);
    min-block-size: 36px;
    font-size: var(--font-size--sm);
  }

  .at-guide-navigation__icon {
    flex-shrink: 0;
  }

  .at-guide-navigation a span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .at-guide-target {
    scroll-margin-block-start: var(--padding-sm);
    text-wrap: balance;
  }

  body:has(#header-component[sticky='always']) .at-guide-target {
    scroll-margin-block-start: calc(var(--header-height, 0px) + var(--padding-sm));
  }

  /* Buying guide tiers: shared pieces rendered by custom-liquid blocks in the guide templates. */
  .at-tier-title {
    margin: 0;
    color: #233d31;
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.75rem);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .at-tier-title--on-dark {
    color: #fbf8f2;
  }

  /* Tier layout: header group, card panel, footer row (direct children of the section). */
  .section:has(.at-tier-title) {
    overflow-x: clip;
  }

  .section:has(.at-tier-title--on-dark) .section-content-wrapper > .group-block:first-child {
    position: relative;
    z-index: 0;
  }

  .section:has(.at-tier-title--on-dark) .section-content-wrapper > .group-block:first-child::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -56px -100vw -96px;
    background: #233d31;
  }

  .section:has(.at-tier-title--on-dark) .section-content-wrapper > .group-block:nth-child(2) {
    position: relative;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06), 0 12px 32px -18px rgb(35 61 49 / 0.35);
  }

  .section:has(.at-tier-title:not(.at-tier-title--on-dark)) .section-content-wrapper > .group-block:first-child {
    margin-block-end: 28px;
    border-block-end: 1px solid rgb(35 61 49 / 0.14);
  }

  /* Equal-height columns; photo + meta sit at the bottom so photos line up across columns. */
  .section:has(.at-tier-title) .group-block-content:has(> .product-card) {
    align-items: stretch;
  }

  .section:has(.at-tier-title) .product-card__content {
    block-size: 100%;
  }

  .section:has(.at-tier-title) .product-card__content > :is(.card-gallery, :has(.at-guide-product-photo)) {
    margin-block-start: auto;
  }

  .section:has(.at-tier-title) .at-tier-card__meta {
    min-block-size: 40px;
  }

  .section:has(.at-tier-title) .product-card + .product-card {
    border-inline-start: 1px solid rgb(35 61 49 / 0.12);
  }

  .section:has(.at-tier-title) .section-content-wrapper > .group-block:last-child {
    margin-block-start: 32px;
    border-block-start: 1px solid rgb(35 61 49 / 0.14);
  }

  .section:has(.at-tier-title) .section-content-wrapper > .group-block:last-child a:not(.at-tier-next) {
    color: #233d31;
    text-decoration: none;
  }

  @media screen and (min-width: 750px) and (max-width: 1099px) {
    .section:has(.at-tier-title) .group-block-content:has(> .product-card) {
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .section:has(.at-tier-title) .product-card {
      flex: 0 0 min(36%, 300px);
      scroll-snap-align: start;
    }
  }

  @media screen and (max-width: 749px) {
    .section:has(.at-tier-title) .group-block-content:has(> .product-card) {
      flex-wrap: nowrap;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .section:has(.at-tier-title) .product-card {
      flex-shrink: 0;
      scroll-snap-align: start;
    }

    /* Recommendation labels are guidance: show them in full instead of the theme's 3-line title clamp. */
    .section:has(.at-tier-title) .product-card .text-block:is(h4, .h4) {
      display: block;
      overflow: visible;
      -webkit-line-clamp: unset;
      font-size: 1.25rem;
    }
  }

  .section:has(.at-tier-title) .at-guide-product-photo img {
    aspect-ratio: 1;
  }

  .section:has(.at-tier-title) .at-card-video {
    --at-card-video-ratio: 1;
  }

  .section:has(.at-tier-title) .at-card-video__video {
    mix-blend-mode: multiply;
  }

  .section:has(.at-tier-title) .compare-at-price {
    font-family: var(--font-body--family);
    font-size: 0.6em;
    font-weight: 400;
  }

  .section:has(.at-tier-title) .product-card .card-gallery,
  .section:has(.at-tier-title) .at-guide-product-photo {
    overflow: hidden;
    border-radius: 6px;
    background: #ebebea;
  }

  .section:has(.at-tier-title) .product-card .card-gallery slideshow-container {
    background: transparent;
  }

  .section:has(.at-tier-title) .product-card :is(.card-gallery, .at-guide-product-photo) img {
    mix-blend-mode: multiply;
  }

  .section:has(.at-tier-title) .product-card .product-badges:not(:has(.product-badges__badge--featured)) {
    display: none;
  }

  .section:has(.at-tier-title) .button-custom {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 14px 22px;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
  }

  .section:has(.at-tier-title) .button-custom::after {
    content: '\2192';
    font-size: 1.15em;
  }

  .at-tier-card__meta > span:first-child {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .at-tier-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-sm);
    padding-block-start: var(--padding-2xs, 4px);
    font-size: var(--font-size--xs, 0.8125rem);
    line-height: 1.35;
    color: rgb(35 61 49 / 0.72);
  }

  /* Companion fits: youth / women's / tall links grouped under a card's description. */
  .at-tier-card__companions {
    margin: 0;
    font-size: var(--font-size--xs, 0.8125rem);
    line-height: 1.6;
    color: rgb(35 61 49 / 0.72);
  }

  .at-tier-card__companions > span {
    display: block;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #233d31;
  }

  .at-tier-card__companions a {
    position: relative;
    color: #233d31;
    text-decoration: underline;
    text-decoration-color: rgb(35 61 49 / 0.35);
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }

  .at-tier-card__companions a:hover {
    text-decoration-color: currentColor;
  }

  .at-tier-card__arrow {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    inline-size: 36px;
    block-size: 36px;
    border: 1px solid rgb(35 61 49 / 0.22);
    border-radius: 50%;
    color: #233d31;
    background: #fff;
    transition: background-color var(--animation-speed, 0.2s) ease, color var(--animation-speed, 0.2s) ease;
  }

  .at-tier-card__arrow svg,
  .at-tier-next__arrow svg {
    inline-size: 16px;
    block-size: 16px;
    --icon-stroke-width: 1.75px;
  }

  .product-card:hover .at-tier-card__arrow,
  .product-card:focus-within .at-tier-card__arrow {
    background: #233d31;
    color: #fff;
  }

  .at-tier-next {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-md);
    padding: 12px 20px;
    border-radius: 8px;
    background: rgb(35 61 49 / 0.07);
    color: #233d31;
    text-decoration: none;
    white-space: nowrap;
  }

  .group-block-content > :only-child:has(> .at-tier-next) {
    margin-inline-start: auto;
  }

  /* Tier note: guidance that fills the panel beside a short (1–2 card) selection. */
  .at-tier-note {
    display: flex;
    flex-direction: column;
    gap: 10px;
    block-size: 100%;
    padding: 4px 28px 8px;
    border-inline-start: 1px solid rgb(35 61 49 / 0.12);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: #4d544f;
  }

  .at-tier-note p {
    margin: 0;
  }

  .at-tier-note .at-tier-note__eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #233d31;
  }

  .at-tier-note .at-tier-note__title {
    max-inline-size: 18ch;
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2.125rem);
    line-height: 1.1;
    color: #233d31;
  }

  .at-tier-note > p:not([class]) {
    max-inline-size: 46ch;
  }

  .at-tier-note__link {
    align-self: flex-start;
    margin-block-start: 6px;
    color: #233d31;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .section:has(.at-tier-title) .group-block-content:has(> .product-card) > :has(> .at-tier-note) {
    flex: 1 1 0;
    align-self: stretch;
  }

  @media screen and (max-width: 749px) {
    .section:has(.at-tier-title) .group-block-content:has(> .product-card) > :has(> .at-tier-note) {
      flex: 0 0 78%;
      scroll-snap-align: start;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1099px) {
    .section:has(.at-tier-title) .group-block-content:has(> .product-card) > :has(> .at-tier-note) {
      flex: 0 0 min(48%, 380px);
      scroll-snap-align: start;
    }
  }

  .at-tier-next:hover {
    background: rgb(35 61 49 / 0.12);
  }

  .at-tier-next__label {
    padding-inline-end: var(--gap-md);
    border-inline-end: 1px solid rgb(35 61 49 / 0.2);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .at-tier-next__arrow {
    display: inline-flex;
    margin-inline-start: var(--gap-lg);
    transform: rotate(90deg);
  }

  /* Pre-quote checklist: compact numbered row above the full grid. */
  .at-checklist {
    display: grid;
    gap: 24px;
  }

  .at-checklist__eyebrow {
    margin: 0 0 6px;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #233d31;
  }

  .at-checklist__title {
    margin: 0;
    font-family: 'Iowan Old Style', 'Palatino Linotype', Palatino, Georgia, serif;
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem);
    font-weight: 400;
    line-height: 1.08;
    color: #233d31;
    scroll-margin-block-start: var(--padding-sm);
  }

  .at-checklist__items {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: at-checklist;
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06), 0 12px 32px -18px rgb(35 61 49 / 0.35);
  }

  .at-checklist__items li {
    counter-increment: at-checklist;
    padding: 22px 24px 24px;
    font-size: 0.875rem;
    line-height: 1.55;
    color: #4d544f;
  }

  .at-checklist__items li + li {
    border-inline-start: 1px solid rgb(35 61 49 / 0.12);
  }

  .at-checklist__items strong {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-block-end: 6px;
    font-size: 1rem;
    color: #233d31;
  }

  .at-checklist__items strong::before {
    content: counter(at-checklist, decimal-leading-zero);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: rgb(35 61 49 / 0.55);
  }

  .at-checklist__items p {
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .at-checklist__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .at-checklist__items li:nth-child(3) {
      border-inline-start: 0;
    }

    .at-checklist__items li:nth-child(n + 3) {
      border-block-start: 1px solid rgb(35 61 49 / 0.12);
    }
  }

  @media screen and (max-width: 559px) {
    .at-checklist__items {
      grid-template-columns: 1fr;
    }

    .at-checklist__items li + li {
      border-inline-start: 0;
      border-block-start: 1px solid rgb(35 61 49 / 0.12);
    }
  }

  /* Hero top picks: compact product cards rendered with custom-liquid thumb + name. */
  .product-card:has(.at-top-pick__thumb) .product-card__content {
    block-size: 100%;
    border: 1px solid rgb(35 61 49 / 0.1);
    transition: box-shadow var(--animation-speed, 0.2s) ease, border-color var(--animation-speed, 0.2s) ease;
  }

  .product-card:has(.at-top-pick__thumb):hover .product-card__content {
    border-color: rgb(35 61 49 / 0.25);
    box-shadow: 0 10px 24px -16px rgb(35 61 49 / 0.45);
  }

  .at-top-pick__thumb {
    flex-shrink: 0;
    inline-size: 72px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
    background: #ebebea;
  }

  .at-top-pick__thumb {
    position: relative;
  }

  /* Ashley's Choice seal: monogram stamp with a stitched ring, on hero top-pick thumbnails. */
  .at-choice-seal {
    position: absolute;
    inset-block-start: 4px;
    inset-inline-end: 4px;
    display: grid;
    place-items: center;
    inline-size: 28px;
    block-size: 28px;
    border-radius: 50%;
    outline: 1px dashed rgb(239 227 200 / 0.85);
    outline-offset: -3px;
    color: #efe3c8;
    background: #233d31;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.25);
  }

  .at-choice-seal svg {
    block-size: 15px;
    inline-size: auto;
    margin-inline-start: 1px;
  }

  .at-top-pick__thumb img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
  }

  .at-top-pick__name {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 0.875rem;
    line-height: 1.3;
    color: rgb(35 61 49 / 0.8);
  }

  .product-card:has(.at-top-pick__thumb) .compare-at-price {
    font-size: 0.8em;
    font-weight: 400;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Buying guide navigation",
  "tag": null,
  "settings": [
    { "type": "text", "id": "label", "label": "Navigation label", "default": "Shop by priority" },
    { "type": "text", "id": "label_1", "label": "First link label" },
    { "type": "url", "id": "link_1", "label": "First link destination" },
    { "type": "text", "id": "label_2", "label": "Second link label" },
    { "type": "url", "id": "link_2", "label": "Second link destination" },
    { "type": "text", "id": "label_3", "label": "Third link label" },
    { "type": "url", "id": "link_3", "label": "Third link destination" },
    { "type": "text", "id": "label_4", "label": "Fourth link label" },
    { "type": "url", "id": "link_4", "label": "Fourth link destination" }
  ],
  "presets": [{ "name": "Buying guide navigation" }]
}
{% endschema %}
