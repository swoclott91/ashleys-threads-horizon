{%- liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{%- capture badges -%}
  {%- for index in (1..5) -%}
    {%- liquid
      assign prefix = 'badge_' | append: index | append: '_'
      assign source_key = prefix | append: 'source'
      assign custom_key = prefix | append: 'metafield'
      assign match_key = prefix | append: 'match'
      assign label_key = prefix | append: 'label'
      assign icon_key = prefix | append: 'icon'
      assign content_key = prefix | append: 'content'
      assign metafield_path = block.settings[source_key]
      if metafield_path == 'custom'
        assign metafield_path = block.settings[custom_key]
      endif
      assign entry_field = block.settings.metaobject_field
      if metafield_path == 'shopify.clothing-features'
        assign entry_field = 'label'
      endif
      assign label = block.settings[label_key] | strip
    -%}
    {%- capture matches -%}
      {%- render 'feature-badge-matches',
        product: product_resource,
        metafield_path: metafield_path,
        match_value: block.settings[match_key],
        entry_field: entry_field
      -%}
    {%- endcapture -%}
    {%- if matches == 'true' and label != blank -%}
      {%- assign badge_id = 'feature-badge-' | append: section.id | append: '-' | append: block.id | append: '-' | append: index -%}
      {% render 'feature-badge',
        badge_id: badge_id,
        label: label,
        icon: block.settings[icon_key],
        content: block.settings[content_key],
        settings: block.settings
      %}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign badges = badges | strip -%}

{%- if badges != blank or request.design_mode -%}
  <div
    class="feature-badges spacing-style"
    style="--feature-badges-gap: {{ block.settings.gap }}px; --feature-badges-icon-width: {{ block.settings.icon_width }}px; {% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    {%- if badges != blank -%}
      {{ badges }}
    {%- else -%}
      <p class="feature-badges__empty paragraph">No feature badges match this product. Configure a metafield, matching value, and label for each row.</p>
    {%- endif -%}
  </div>
{%- endif -%}

{%- if badges != blank -%}
  <script src="{{ 'dialog.js' | asset_url }}" type="module"></script>
  {% render 'dialog-styles' %}
  {% render 'popup-link-styles' %}
{%- endif -%}

{% stylesheet %}
  .feature-badges {
    display: grid;
    gap: var(--feature-badges-gap);
    width: 100%;
  }

  .feature-badges__row {
    display: block;
    min-width: 0;
  }

  .feature-badges__trigger {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    width: fit-content;
    max-width: 100%;
    color: inherit;
    text-align: start;
    white-space: normal;
  }

  .feature-badges__trigger:hover span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .feature-badges__trigger:focus-visible {
    outline: 0.2rem solid rgb(var(--color-foreground-rgb) / 0.5);
    outline-offset: 0.2rem;
  }

  .feature-badges__icon {
    flex: 0 0 var(--feature-badges-icon-width);
    width: var(--feature-badges-icon-width);
    height: var(--feature-badges-icon-width);
  }

  .feature-badges__heading {
    margin-block: 0 var(--gap-md);
  }

  .feature-badges__dialog {
    overflow-wrap: anywhere;
  }

  .feature-badges__empty {
    margin: 0;
    opacity: var(--opacity-subdued-text);
  }
{% endstylesheet %}

