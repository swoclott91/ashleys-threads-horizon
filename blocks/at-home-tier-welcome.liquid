{%- comment -%}
  Tier welcome tile for Pro and Wholesale customers, in the promo row of the signed-in homepage
  (sections/at-guest-home.liquid), where Members see the "Save More with Pro" estimate.
  Shows the heading and text for the visitor's tier (`at-member-tier`, so the editor's
  "Preview tier as" applies) and a link that defaults to the customer account.
{%- endcomment -%}
{%- capture at_tw_tier -%}{% render 'at-member-tier' %}{%- endcapture -%}
{%- liquid
  assign at_tw_tier = at_tw_tier | strip
  if at_tw_tier == 'wholesale'
    assign heading = block.settings.wholesale_heading
    assign text = block.settings.wholesale_text
  else
    assign heading = block.settings.pro_heading
    assign text = block.settings.pro_text
  endif
  assign link = block.settings.link | default: routes.account_url
-%}
<div class="at-home-pro at-home-tier-welcome" {{ block.shopify_attributes }}>
  {%- if heading != blank -%}
    <h2 class="h2">{{ heading | escape }}</h2>
  {%- endif -%}
  {%- if text != blank -%}
    <p>{{ text | escape }}</p>
  {%- endif -%}
  {%- if block.settings.link_label != blank -%}
    <a class="button-secondary" href="{{ link }}">{{ block.settings.link_label | escape }}</a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Tier welcome",
  "tag": null,
  "settings": [
    { "type": "paragraph", "content": "Shown to Pro and Wholesale customers in place of the Pro savings estimate." },
    { "type": "header", "content": "Pro" },
    { "type": "text", "id": "pro_heading", "label": "Heading", "default": "You're Pro" },
    { "type": "textarea", "id": "pro_text", "label": "Text", "default": "Pro pricing is on for every order. Thanks for being a Pro member." },
    { "type": "header", "content": "Wholesale" },
    { "type": "text", "id": "wholesale_heading", "label": "Heading", "default": "Your wholesale account" },
    { "type": "textarea", "id": "wholesale_text", "label": "Text", "default": "Wholesale pricing is on for every order." },
    { "type": "header", "content": "Link" },
    { "type": "text", "id": "link_label", "label": "Label", "default": "View your account" },
    { "type": "url", "id": "link", "label": "Link", "info": "Defaults to the customer account." }
  ],
  "presets": [{ "name": "Tier welcome" }]
}
{% endschema %}
